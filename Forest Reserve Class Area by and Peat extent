# ============================================================
# 28. Create compact forest-reserve summary
# ============================================================

reserve_summary <- results_formatted |>
  dplyr::filter(
    Extent_type !=
      "Processing error",
    !Forest_class %in%
      c(
        "No matching extent",
        "No valid geometry"
      )
  ) |>
  dplyr::group_by(
    Area_name,
    Extent_type,
    Extent_area_ha
  ) |>
  dplyr::summarise(
    Area_in_forest_reserves_ha =
      sum(
        Forest_class_area_ha[
          Forest_class !=
            "Outside forest reserves"
        ],
        na.rm = TRUE
      ),
    Area_outside_forest_reserves_ha =
      sum(
        Forest_class_area_ha[
          Forest_class ==
            "Outside forest reserves"
        ],
        na.rm = TRUE
      ),
    .groups = "drop"
  ) |>
  dplyr::mutate(
    Percentage_in_forest_reserves =
      dplyr::if_else(
        Extent_area_ha > 0,
        Area_in_forest_reserves_ha /
          Extent_area_ha *
          100,
        NA_real_
      ),
    Percentage_outside_forest_reserves =
      dplyr::if_else(
        Extent_area_ha > 0,
        Area_outside_forest_reserves_ha /
          Extent_area_ha *
          100,
        NA_real_
      )
  ) |>
  dplyr::mutate(
    dplyr::across(
      where(is.numeric),
      ~ round(.x, 2)
    )
  )


# ============================================================
# 29. Create wide-format results
# ============================================================

results_wide <- results_formatted |>
  dplyr::filter(
    Extent_type !=
      "Processing error"
  ) |>
  dplyr::select(
    Area_name,
    Extent_type,
    Extent_area_ha,
    Forest_class,
    Forest_class_area_ha
  ) |>
  tidyr::pivot_wider(
    names_from =
      Forest_class,
    values_from =
      Forest_class_area_ha,
    values_fill = 0,
    names_prefix =
      "Area_ha_"
  ) |>
  dplyr::rename_with(
    function(column_name) {
      
      column_name |>
        stringr::str_replace_all(
          "[^A-Za-z0-9]+",
          "_"
        ) |>
        stringr::str_replace_all(
          "^_+|_+$",
          ""
        )
    }
  )


# ============================================================
# 30. Area reconciliation check
#
# The sum of:
#   forest-class areas + outside-reserve area
#
# should approximately equal the source extent.
#
# A positive difference may indicate overlapping polygons
# assigned to different forest classes.
# ============================================================

area_reconciliation <- results_formatted |>
  dplyr::filter(
    Extent_type !=
      "Processing error",
    !Forest_class %in%
      c(
        "No matching extent",
        "No valid geometry"
      )
  ) |>
  dplyr::group_by(
    Area_name,
    Extent_type,
    Extent_area_ha
  ) |>
  dplyr::summarise(
    Sum_of_class_and_outside_areas_ha =
      sum(
        Forest_class_area_ha,
        na.rm = TRUE
      ),
    Difference_ha =
      Sum_of_class_and_outside_areas_ha -
      dplyr::first(
        Extent_area_ha
      ),
    .groups = "drop"
  ) |>
  dplyr::mutate(
    dplyr::across(
      where(is.numeric),
      ~ round(.x, 2)
    ),
    Reconciliation_status =
      dplyr::case_when(
        abs(Difference_ha) <= 1 ~
          "OK",
        Difference_ha > 1 ~
          "Possible overlap between forest classes",
        Difference_ha < -1 ~
          "Possible missing area",
        TRUE ~
          "Check"
      )
  )


