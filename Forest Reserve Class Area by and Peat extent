# ============================================================
# 8. Standardise a field name
#
# This finds a field case-insensitively and renames it to the
# requested standard name.
# ============================================================

standardise_field_name <- function(
    spatial_object,
    required_name) {
  
  matching_fields <- names(spatial_object)[
    toupper(names(spatial_object)) ==
      toupper(required_name)
  ]
  
  if (length(matching_fields) == 0) {
    
    stop(
      paste(
        "Required field not found:",
        required_name
      )
    )
  }
  
  current_name <- matching_fields[1]
  
  if (current_name != required_name) {
    
    names(spatial_object)[
      names(spatial_object) ==
        current_name
    ] <- required_name
  }
  
  spatial_object
}


# ============================================================
# 9. Match soil associations
#
# This permits values such as:
#   Klias
#   Klias Association
#   KLIAS SOIL ASSOCIATION
#   Klias / Sipitang
# ============================================================

matches_soil_association <- function(
    soil_values,
    target_associations) {
  
  cleaned_values <- clean_text(
    soil_values
  )
  
  association_pattern <- paste0(
    "\\b(",
    paste(
      target_associations,
      collapse = "|"
    ),
    ")\\b"
  )
  
  !is.na(cleaned_values) &
    stringr::str_detect(
      cleaned_values,
      association_pattern
    )
}


# ============================================================
# 10. Clean and repair polygon geometries
#
# This function:
#   - removes missing geometry;
#   - removes empty geometry;
#   - repairs invalid geometry;
#   - extracts polygon parts from geometry collections;
#   - repairs geometry again after extraction;
#   - does not assume the geometry column is named geometry.
# ============================================================

clean_polygon_geometry <- function(
    spatial_object,
    object_name = "spatial object") {
  
  if (!inherits(spatial_object, "sf")) {
    
    stop(
      paste(
        object_name,
        "is not an sf object."
      )
    )
  }
  
  if (is.na(sf::st_crs(spatial_object))) {
    
    stop(
      paste(
        object_name,
        "does not have a defined CRS."
      )
    )
  }
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  # Remove missing geometry
  geometry_missing <- is.na(
    sf::st_geometry(spatial_object)
  )
  
  spatial_object <- spatial_object[
    !geometry_missing,
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  # Remove empty geometry
  spatial_object <- spatial_object[
    !sf::st_is_empty(spatial_object),
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  # Repair invalid geometry
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  # Remove missing or empty geometry created during repair
  spatial_object <- spatial_object[
    !is.na(sf::st_geometry(spatial_object)),
  ]
  
  spatial_object <- spatial_object[
    !sf::st_is_empty(spatial_object),
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  geometry_types <- unique(
    as.character(
      sf::st_geometry_type(
        spatial_object
      )
    )
  )
  
  # Extract polygon components if geometry collections
  # or non-polygon components are present
  if (
    any(
      geometry_types %in%
      c(
        "GEOMETRYCOLLECTION",
        "LINESTRING",
        "MULTILINESTRING",
        "POINT",
        "MULTIPOINT"
      )
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON",
        warn = FALSE
      )
    )
  }
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  # Final repair
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !sf::st_is_empty(spatial_object),
  ]
  
  spatial_object
}


# ============================================================
# 11. Read the appropriate PHU layer
#
# Searches all layers in each GeoPackage and returns the first
# polygon layer containing SO_ASSOCIA.
# ============================================================

read_phu_gpkg <- function(gpkg_file) {
  
  layer_information <- sf::st_layers(
    gpkg_file
  )
  
  available_layers <- layer_information$name
  
  if (length(available_layers) == 0) {
    
    stop(
      paste(
        "No layers found in:",
        basename(gpkg_file)
      )
    )
  }
  
  for (layer_name in available_layers) {
    
    layer_object <- tryCatch(
      sf::st_read(
        dsn = gpkg_file,
        layer = layer_name,
        quiet = TRUE
      ),
      error = function(e) {
        
        NULL
      }
    )
    
    if (is.null(layer_object)) {
      
      next
    }
    
    if (!inherits(layer_object, "sf")) {
      
      next
    }
    
    soil_field <- names(layer_object)[
      toupper(names(layer_object)) ==
        "SO_ASSOCIA"
    ]
    
    if (length(soil_field) == 0) {
      
      next
    }
    
    geometry_types <- unique(
      as.character(
        sf::st_geometry_type(
          layer_object
        )
      )
    )
    
    acceptable_types <- c(
      "POLYGON",
      "MULTIPOLYGON",
      "GEOMETRYCOLLECTION"
    )
    
    if (
      !any(
        geometry_types %in%
        acceptable_types
      )
    ) {
      
      next
    }
    
    layer_object <- standardise_field_name(
      spatial_object = layer_object,
      required_name = "SO_ASSOCIA"
    )
    
    layer_object <- clean_polygon_geometry(
      spatial_object = layer_object,
      object_name = basename(gpkg_file)
    )
    
    return(layer_object)
  }
  
  stop(
    paste(
      "No polygon layer containing SO_ASSOCIA",
      "was found in:",
      basename(gpkg_file)
    )
  )
}


