# ============================================================
# 20. Summarise forest classes for one extent
# ============================================================

summarise_forest_classes <- function(
    source_extent,
    source_name,
    extent_type) {
  
  # ----------------------------------------------------------
  # Missing extent
  # ----------------------------------------------------------
  
  if (
    is.null(source_extent) ||
    nrow(source_extent) == 0
  ) {
    
    return(
      tibble::tibble(
        Area_name = source_name,
        Extent_type = extent_type,
        Forest_class = "No matching extent",
        Extent_area_ha = 0,
        Forest_class_area_ha = 0,
        Percentage_of_extent =
          NA_real_
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Transform and clean source extent
  # ----------------------------------------------------------
  
  source_extent <- sf::st_transform(
    source_extent,
    crs = analysis_crs
  )
  
  source_extent <- clean_polygon_geometry(
    spatial_object = source_extent,
    object_name = paste(
      source_name,
      extent_type
    )
  )
  
  if (nrow(source_extent) == 0) {
    
    return(
      tibble::tibble(
        Area_name = source_name,
        Extent_type = extent_type,
        Forest_class = "No valid geometry",
        Extent_area_ha = 0,
        Forest_class_area_ha = 0,
        Percentage_of_extent =
          NA_real_
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Dissolve source extent
  # ----------------------------------------------------------
  
  source_union <- suppressWarnings(
    sf::st_union(
      sf::st_geometry(
        source_extent
      )
    )
  )
  
  source_extent <- sf::st_sf(
    extent_id = 1,
    geom = source_union
  )
  
  sf::st_crs(source_extent) <-
    analysis_crs
  
  source_extent <- clean_polygon_geometry(
    spatial_object = source_extent,
    object_name = paste(
      source_name,
      extent_type,
      "dissolved extent"
    )
  )
  
  if (nrow(source_extent) == 0) {
    
    return(
      tibble::tibble(
        Area_name = source_name,
        Extent_type = extent_type,
        Forest_class = "No valid geometry",
        Extent_area_ha = 0,
        Forest_class_area_ha = 0,
        Percentage_of_extent =
          NA_real_
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Total extent area
  # ----------------------------------------------------------
  
  total_extent_area_ha <- calculate_area_ha(
    source_extent
  )
  
  
  # ----------------------------------------------------------
  # Intersect source extent with forest-reserve classes
  # ----------------------------------------------------------
  
  class_intersections <- tryCatch(
    suppressWarnings(
      sf::st_intersection(
        forest_reserves_by_class,
        source_extent
      )
    ),
    error = function(e) {
      
      warning(
        paste(
          "Forest-class intersection failed for",
          source_name,
          "-",
          extent_type,
          ":",
          conditionMessage(e)
        )
      )
      
      NULL
    }
  )
  
  
  # ----------------------------------------------------------
  # Calculate area in each forest class
  # ----------------------------------------------------------
  
  if (
    !is.null(class_intersections) &&
    nrow(class_intersections) > 0
  ) {
    
    class_intersections <-
      clean_polygon_geometry(
        spatial_object =
          class_intersections,
        object_name = paste(
          source_name,
          extent_type,
          "forest-class intersection"
        )
      )
  }
  
  if (
    !is.null(class_intersections) &&
    nrow(class_intersections) > 0
  ) {
    
    class_intersections$Forest_class_area_ha <-
      as.numeric(
        sf::st_area(
          class_intersections
        )
      ) / 10000
    
    class_results <-
      class_intersections |>
      sf::st_drop_geometry() |>
      dplyr::group_by(
        Forest_class
      ) |>
      dplyr::summarise(
        Forest_class_area_ha =
          sum(
            Forest_class_area_ha,
            na.rm = TRUE
          ),
        .groups = "drop"
      )
    
  } else {
    
    class_results <- tibble::tibble(
      Forest_class = character(),
      Forest_class_area_ha = numeric()
    )
  }
  
  
  # ----------------------------------------------------------
  # Calculate area outside forest reserves
  # ----------------------------------------------------------
  
  outside_reserve <- tryCatch(
    suppressWarnings(
      sf::st_difference(
        source_extent,
        forest_reserve_footprint
      )
    ),
    error = function(e) {
      
      warning(
        paste(
          "Outside-reserve calculation failed for",
          source_name,
          "-",
          extent_type,
          ":",
          conditionMessage(e)
        )
      )
      
      NULL
    }
  )
  
  if (
    is.null(outside_reserve) ||
    nrow(outside_reserve) == 0
  ) {
    
    outside_area_ha <- 0
    
  } else {
    
    outside_reserve <- clean_polygon_geometry(
      spatial_object = outside_reserve,
      object_name = paste(
        source_name,
        extent_type,
        "outside forest reserves"
      )
    )
    
    if (nrow(outside_reserve) == 0) {
      
      outside_area_ha <- 0
      
    } else {
      
      outside_area_ha <- calculate_area_ha(
        outside_reserve
      )
    }
  }
  
  
  outside_result <- tibble::tibble(
    Forest_class =
      "Outside forest reserves",
    Forest_class_area_ha =
      outside_area_ha
  )
  
  
  # ----------------------------------------------------------
  # Combine results
  # ----------------------------------------------------------
  
  final_results <- dplyr::bind_rows(
    class_results,
    outside_result
  )
  
  final_results$Area_name <-
    source_name
  
  final_results$Extent_type <-
    extent_type
  
  final_results$Extent_area_ha <-
    total_extent_area_ha
  
  if (
    is.finite(total_extent_area_ha) &&
    total_extent_area_ha > 0
  ) {
    
    final_results$Percentage_of_extent <-
      final_results$Forest_class_area_ha /
      total_extent_area_ha *
      100
    
  } else {
    
    final_results$Percentage_of_extent <-
      NA_real_
  }
  
  final_results |>
    dplyr::select(
      Area_name,
      Extent_type,
      Forest_class,
      Extent_area_ha,
      Forest_class_area_ha,
      Percentage_of_extent
    )
}


# ============================================================
# 21. Process one PHU
# ============================================================

process_phu <- function(gpkg_file) {
  
  phu_name <- tools::file_path_sans_ext(
    basename(gpkg_file)
  )
  
  message(
    "Processing PHU: ",
    phu_name
  )
  
  phu_data <- read_phu_gpkg(
    gpkg_file
  )
  
  invalid_count <- sum(
    !sf::st_is_valid(
      phu_data
    )
  )
  
  if (invalid_count > 0) {
    
    warning(
      paste(
        phu_name,
        "still contains",
        invalid_count,
        "invalid geometries after repair."
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Total PHU
  # ----------------------------------------------------------
  
  total_phu <- prepare_extent(
    spatial_data = phu_data,
    soil_associations = NULL,
    extent_name = paste(
      phu_name,
      "total PHU"
    )
  )
  
  
  # ----------------------------------------------------------
  # DoA peat extent
  # ----------------------------------------------------------
  
  doa_peat <- prepare_extent(
    spatial_data = phu_data,
    soil_associations =
      doa_peat_associations,
    extent_name = paste(
      phu_name,
      "DoA peat"
    )
  )
  
  
  # ----------------------------------------------------------
  # SFD peat extent
  # ----------------------------------------------------------
  
  sfd_peat <- prepare_extent(
    spatial_data = phu_data,
    soil_associations =
      sfd_peat_associations,
    extent_name = paste(
      phu_name,
      "SFD peat"
    )
  )
  
  
  # ----------------------------------------------------------
  # Forest-class summaries
  # ----------------------------------------------------------
  
  dplyr::bind_rows(
    
    summarise_forest_classes(
      source_extent = total_phu,
      source_name = phu_name,
      extent_type = "Total PHU"
    ),
    
    summarise_forest_classes(
      source_extent = doa_peat,
      source_name = phu_name,
      extent_type =
        "DoA peat extent"
    ),
    
    summarise_forest_classes(
      source_extent = sfd_peat,
      source_name = phu_name,
      extent_type =
        "SFD peat extent"
    )
  )
}


