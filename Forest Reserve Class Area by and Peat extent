# ============================================================
# 13. Prepare and dissolve one source extent
#
# soil_associations = NULL returns the full input extent.
# ============================================================

prepare_extent <- function(
    spatial_data,
    soil_associations = NULL,
    extent_name = "source extent") {
  
  extent_data <- spatial_data
  
  if (!is.null(soil_associations)) {
    
    selected_rows <- matches_soil_association(
      soil_values =
        extent_data$SO_ASSOCIA,
      target_associations =
        soil_associations
    )
    
    extent_data <- extent_data[
      selected_rows,
    ]
  }
  
  if (nrow(extent_data) == 0) {
    
    return(NULL)
  }
  
  extent_data <- clean_polygon_geometry(
    spatial_object = extent_data,
    object_name = extent_name
  )
  
  if (nrow(extent_data) == 0) {
    
    return(NULL)
  }
  
  dissolved_geometry <- suppressWarnings(
    sf::st_union(
      sf::st_geometry(
        extent_data
      )
    )
  )
  
  dissolved_extent <- sf::st_sf(
    extent_id = 1,
    geom = dissolved_geometry
  )
  
  sf::st_crs(dissolved_extent) <-
    sf::st_crs(extent_data)
  
  dissolved_extent <- clean_polygon_geometry(
    spatial_object = dissolved_extent,
    object_name = paste(
      extent_name,
      "dissolved"
    )
  )
  
  dissolved_extent
}


# ============================================================
# 14. Calculate area in hectares
# ============================================================

calculate_area_ha <- function(spatial_object) {
  
  if (
    is.null(spatial_object) ||
    nrow(spatial_object) == 0
  ) {
    
    return(0)
  }
  
  equal_area_object <- sf::st_transform(
    spatial_object,
    crs = analysis_crs
  )
  
  sum(
    as.numeric(
      sf::st_area(
        equal_area_object
      )
    ),
    na.rm = TRUE
  ) / 10000
}


