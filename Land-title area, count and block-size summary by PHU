# ============================================================
# 7. Text-cleaning functions
# ============================================================

clean_text <- function(x) {
  
  x |>
    as.character() |>
    stringr::str_squish() |>
    stringr::str_to_upper()
}


normalise_field_name <- function(x) {
  
  x |>
    as.character() |>
    stringr::str_to_upper() |>
    stringr::str_replace_all(
      "[^A-Z0-9]",
      ""
    )
}


clean_title_type <- function(x) {
  
  cleaned <- clean_text(x)
  
  cleaned[
    is.na(cleaned) |
      cleaned == "" |
      cleaned == "NA" |
      cleaned == "<NULL>" |
      cleaned == "NULL VALUE"
  ] <- "NULL"
  
  cleaned
}


parse_hectares <- function(x) {
  
  cleaned <- as.character(x)
  
  cleaned <- stringr::str_replace_all(
    cleaned,
    ",",
    ""
  )
  
  cleaned <- stringr::str_squish(
    cleaned
  )
  
  suppressWarnings(
    as.numeric(cleaned)
  )
}


# ============================================================
# 8. Field-name functions
# ============================================================

find_field_name <- function(
    spatial_object,
    possible_names) {
  
  existing_names <- names(
    spatial_object
  )
  
  normalised_existing <- normalise_field_name(
    existing_names
  )
  
  normalised_possible <- normalise_field_name(
    possible_names
  )
  
  matching_position <- which(
    normalised_existing %in%
      normalised_possible
  )
  
  if (length(matching_position) == 0) {
    
    return(NA_character_)
  }
  
  existing_names[
    matching_position[1]
  ]
}


standardise_field_name <- function(
    spatial_object,
    possible_names,
    new_name) {
  
  existing_field <- find_field_name(
    spatial_object,
    possible_names
  )
  
  if (is.na(existing_field)) {
    
    stop(
      paste(
        "Could not find required field.",
        "Expected one of:",
        paste(
          possible_names,
          collapse = ", "
        )
      )
    )
  }
  
  if (existing_field != new_name) {
    
    names(spatial_object)[
      names(spatial_object) ==
        existing_field
    ] <- new_name
  }
  
  spatial_object
}


# ============================================================
# 9. Match peat soil associations
# ============================================================

matches_soil_association <- function(
    soil_values,
    target_associations) {
  
  cleaned_values <- clean_text(
    soil_values
  )
  
  association_pattern <- paste0(
    "\\b(",
    paste(
      target_associations,
      collapse = "|"
    ),
    ")\\b"
  )
  
  !is.na(cleaned_values) &
    stringr::str_detect(
      cleaned_values,
      association_pattern
    )
}


# ============================================================
# 10. Safely test whether an area is positive
#
# This prevents:
# "missing value where TRUE/FALSE needed"
# ============================================================

is_positive_area <- function(x) {
  
  length(x) == 1 &&
    !is.na(x) &&
    is.finite(x) &&
    x > 0
}


# ============================================================
# 11. Repair polygon geometries
# ============================================================

repair_polygon_geometry <- function(
    spatial_object,
    object_name = "spatial object",
    use_zero_buffer = FALSE,
    remove_zero_area = FALSE) {
  
  if (!inherits(spatial_object, "sf")) {
    
    stop(
      paste(
        object_name,
        "is not an sf object."
      )
    )
  }
  
  if (is.na(sf::st_crs(spatial_object))) {
    
    stop(
      paste(
        object_name,
        "does not have a defined CRS."
      )
    )
  }
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # Remove Z and M dimensions
  spatial_object <- suppressWarnings(
    sf::st_zm(
      spatial_object,
      drop = TRUE,
      what = "ZM"
    )
  )
  
  
  # Remove missing geometry
  geometry_missing <- is.na(
    sf::st_geometry(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !geometry_missing,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # Remove empty geometry
  geometry_empty <- tryCatch(
    sf::st_is_empty(
      spatial_object
    ),
    error = function(e) {
      
      rep(
        FALSE,
        nrow(spatial_object)
      )
    }
  )
  
  geometry_empty[
    is.na(geometry_empty)
  ] <- TRUE
  
  spatial_object <- spatial_object[
    !geometry_empty,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # First validity repair
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  
  # Remove missing and empty geometry after repair
  geometry_missing <- is.na(
    sf::st_geometry(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !geometry_missing,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  geometry_empty <- tryCatch(
    sf::st_is_empty(
      spatial_object
    ),
    error = function(e) {
      
      rep(
        FALSE,
        nrow(spatial_object)
      )
    }
  )
  
  geometry_empty[
    is.na(geometry_empty)
  ] <- TRUE
  
  spatial_object <- spatial_object[
    !geometry_empty,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # Extract polygons from geometry collections
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  if (
    any(
      geometry_types ==
      "GEOMETRYCOLLECTION"
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON"
      )
    )
  }
  
  
  # Retain polygon geometry only
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  polygon_rows <- geometry_types %in%
    c(
      "POLYGON",
      "MULTIPOLYGON"
    )
  
  spatial_object <- spatial_object[
    polygon_rows,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # Optional zero-distance buffer
  if (use_zero_buffer) {
    
    buffered_object <- tryCatch(
      suppressWarnings(
        sf::st_buffer(
          spatial_object,
          dist = 0
        )
      ),
      error = function(e) {
        
        NULL
      }
    )
    
    if (!is.null(buffered_object)) {
      
      spatial_object <- buffered_object
    }
  }
  
  
  # Final validity repair
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  
  # Remove missing and empty geometry again
  geometry_missing <- is.na(
    sf::st_geometry(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !geometry_missing,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  geometry_empty <- tryCatch(
    sf::st_is_empty(
      spatial_object
    ),
    error = function(e) {
      
      rep(
        FALSE,
        nrow(spatial_object)
      )
    }
  )
  
  geometry_empty[
    is.na(geometry_empty)
  ] <- TRUE
  
  spatial_object <- spatial_object[
    !geometry_empty,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # Extract polygon components again if required
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  if (
    any(
      geometry_types ==
      "GEOMETRYCOLLECTION"
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON"
      )
    )
  }
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    geometry_types %in%
      c(
        "POLYGON",
        "MULTIPOLYGON"
      ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # Remove zero-area remnants
  if (remove_zero_area) {
    
    polygon_area <- tryCatch(
      as.numeric(
        sf::st_area(
          spatial_object
        )
      ),
      error = function(e) {
        
        rep(
          NA_real_,
          nrow(spatial_object)
        )
      }
    )
    
    keep_rows <- (
      !is.na(polygon_area) &
        is.finite(polygon_area) &
        polygon_area > 0
    )
    
    spatial_object <- spatial_object[
      keep_rows,
      ,
      drop = FALSE
    ]
  }
  
  spatial_object
}


# ============================================================
# 12. Prepare a layer in the analysis CRS
# ============================================================

prepare_layer_for_analysis <- function(
    spatial_object,
    object_name) {
  
  spatial_object <- repair_polygon_geometry(
    spatial_object = spatial_object,
    object_name = paste(
      object_name,
      "before transformation"
    ),
    use_zero_buffer = FALSE,
    remove_zero_area = FALSE
  )
  
  if (nrow(spatial_object) == 0) {
    
    stop(
      paste(
        object_name,
        "contains no usable polygon geometry."
      )
    )
  }
  
  spatial_object <- sf::st_transform(
    spatial_object,
    crs = analysis_crs
  )
  
  spatial_object <- repair_polygon_geometry(
    spatial_object = spatial_object,
    object_name = paste(
      object_name,
      "in analysis CRS"
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  if (nrow(spatial_object) == 0) {
    
    stop(
      paste(
        object_name,
        "contains no usable polygons after transformation."
      )
    )
  }
  
  spatial_object
}


# ============================================================
# 13. Read cadastral GeoPackage
# ============================================================

read_cadastral_gpkg <- function(gpkg_path) {
  
  layer_names <- sf::st_layers(
    gpkg_path
  )$name
  
  if (length(layer_names) == 0) {
    
    stop(
      paste(
        "No layers were found in:",
        gpkg_path
      )
    )
  }
  
  for (layer_name in layer_names) {
    
    layer_object <- tryCatch(
      sf::st_read(
        dsn = gpkg_path,
        layer = layer_name,
        quiet = TRUE,
        stringsAsFactors = FALSE
      ),
      error = function(e) {
        
        NULL
      }
    )
    
    if (
      is.null(layer_object) ||
      !inherits(layer_object, "sf") ||
      nrow(layer_object) == 0
    ) {
      
      next
    }
    
    title_field <- find_field_name(
      layer_object,
      c(
        "title_type",
        "titletype"
      )
    )
    
    ha_field <- find_field_name(
      layer_object,
      c(
        "ha",
        "hectares",
        "area_ha"
      )
    )
    
    if (
      is.na(title_field) ||
      is.na(ha_field)
    ) {
      
      next
    }
    
    geometry_types <- unique(
      as.character(
        sf::st_geometry_type(
          layer_object
        )
      )
    )
    
    if (
      any(
        geometry_types %in%
        c(
          "POLYGON",
          "MULTIPOLYGON",
          "GEOMETRYCOLLECTION"
        )
      )
    ) {
      
      message(
        "Cadastral layer selected: ",
        layer_name
      )
      
      layer_object <- standardise_field_name(
        spatial_object = layer_object,
        possible_names = c(
          "title_type",
          "titletype"
        ),
        new_name = "title_type"
      )
      
      layer_object <- standardise_field_name(
        spatial_object = layer_object,
        possible_names = c(
          "ha",
          "hectares",
          "area_ha"
        ),
        new_name = "ha"
      )
      
      return(layer_object)
    }
  }
  
  stop(
    paste(
      "No polygon layer containing title_type and ha",
      "was found in:",
      gpkg_path
    )
  )
}


