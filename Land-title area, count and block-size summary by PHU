  dplyr::group_by(
    Title_type
  ) |>
  dplyr::summarise(
    Source_title_count =
      dplyr::n_distinct(
        Title_source_ID
      ),
    
    Titles_with_valid_ha =
      sum(
        !is.na(Title_size_ha) &
          is.finite(Title_size_ha)
      ),
    
    Titles_with_missing_ha =
      sum(
        is.na(Title_size_ha) |
          !is.finite(Title_size_ha)
      ),
    
    Mean_source_ha =
      safe_mean(
        Title_size_ha
      ),
    
    Median_source_ha =
      safe_median(
        Title_size_ha
      ),
    
    .groups = "drop"
  ) |>
  dplyr::arrange(
    match(
      Title_type,
      title_types_to_report
    )
  )


# ============================================================
# 23. Create zero rows for all title classes
#
# This function safely handles NA extent areas.
# ============================================================

make_zero_title_rows <- function(
    phu_name,
    extent_type,
    extent_area_ha,
    status_text) {
  
  percentage_value <- if (
    is_positive_area(
      extent_area_ha
    )
  ) {
    
    0
    
  } else {
    
    NA_real_
  }
  
  tibble::tibble(
    PHU = phu_name,
    Extent_type = extent_type,
    Title_type = title_types_to_report,
    
    Extent_area_ha =
      extent_area_ha,
    
    Total_area_within_extent_ha =
      0,
    
    Percentage_of_extent =
      percentage_value,
    
    Title_count =
      0L,
    
    Mean_title_size_ha =
      NA_real_,
    
    Median_title_size_ha =
      NA_real_,
    
    Count_lt_40_46_ha =
      ifelse(
        title_types_to_report == "TL",
        NA_integer_,
        0L
      ),
    
    Count_40_46_to_500_ha =
      ifelse(
        title_types_to_report == "TL",
        NA_integer_,
        0L
      ),
    
    Count_gt_500_ha =
      ifelse(
        title_types_to_report == "TL",
        NA_integer_,
        0L
      ),
    
    Count_missing_ha =
      0L,
    
    Status =
      status_text
  )
}


# ============================================================
# 24. Intersect titles with one extent
#
# First tries a bulk intersection. If that fails, each source
# title is processed separately.
# ============================================================

intersect_titles_with_extent <- function(
    cadastral_candidates,
    source_extent,
    phu_name,
    extent_type) {
  
  bulk_error <- NULL
  
  title_intersections <- tryCatch(
    suppressWarnings(
      sf::st_intersection(
        cadastral_candidates,
        source_extent
      )
    ),
    error = function(e) {
      
      bulk_error <<-
        conditionMessage(e)
      
      NULL
    }
  )
  
  
  if (
    !is.null(title_intersections) &&
    nrow(title_intersections) > 0
  ) {
    
    title_intersections <- tryCatch(
      repair_polygon_geometry(
        spatial_object =
          title_intersections,
        
        object_name = paste(
          phu_name,
          extent_type,
          "cadastral intersection"
        ),
        
        use_zero_buffer = TRUE,
        remove_zero_area = TRUE
      ),
      error = function(e) {
        
        bulk_error <<-
          conditionMessage(e)
        
        NULL
      }
    )
  }
  
  
  if (
    !is.null(title_intersections) &&
    nrow(title_intersections) > 0
  ) {
    
    return(
      list(
        intersections =
          title_intersections,
        
        errors =
          empty_error_table()
      )
    )
  }
  
  
  if (
    !is.null(title_intersections) &&
    nrow(title_intersections) == 0 &&
    is.null(bulk_error)
  ) {
    
    return(
      list(
        intersections = NULL,
        errors = empty_error_table()
      )
    )
  }
  
  
  warning(
    paste(
      "Bulk cadastral intersection failed for",
      phu_name,
      "-",
      extent_type,
      ". Retrying title by title."
    )
  )
  
  
  intersection_parts <- vector(
    mode = "list",
    length = nrow(cadastral_candidates)
  )
  
  error_parts <- vector(
    mode = "list",
    length = nrow(cadastral_candidates)
  )
  
  
  for (
    title_number in
    seq_len(nrow(cadastral_candidates))
  ) {
    
    title_feature <- cadastral_candidates[
      title_number,
      ,
      drop = FALSE
    ]
    
    title_id <- as.integer(
      title_feature$Title_source_ID[1]
    )
    
    title_class <- as.character(
      title_feature$Title_type[1]
    )
    
    title_error <- NULL
    
    
    title_intersection <- tryCatch(
      suppressWarnings(
        sf::st_intersection(
          title_feature,
          source_extent
        )
      ),
      error = function(e) {
        
        title_error <<-
          conditionMessage(e)
        
        NULL
      }
    )
    
    
    if (
      !is.null(title_intersection) &&
      nrow(title_intersection) > 0
    ) {
      
      title_intersection <- tryCatch(
        repair_polygon_geometry(
          spatial_object =
            title_intersection,
          
          object_name = paste(
            phu_name,
            extent_type,
            "title",
            title_id
          ),
          
          use_zero_buffer = TRUE,
          remove_zero_area = TRUE
        ),
        error = function(e) {
          
          title_error <<-
            conditionMessage(e)
          
          NULL
        }
      )
    }
    
    
    if (
      !is.null(title_intersection) &&
      nrow(title_intersection) > 0
    ) {
      
      intersection_parts[[title_number]] <-
        title_intersection
      
    } else if (!is.null(title_error)) {
      
      error_parts[[title_number]] <-
        tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Title_source_ID =
            title_id,
          Title_type =
            title_class,
          Error_message =
            title_error
        )
    }
  }
  
  
  intersection_parts <- Filter(
    Negate(is.null),
    intersection_parts
  )
  
  error_parts <- Filter(
    Negate(is.null),
    error_parts
  )
  
  
  if (length(intersection_parts) > 0) {
    
    combined_intersections <- do.call(
      what = rbind,
      args = intersection_parts
    )
    
  } else {
    
    combined_intersections <- NULL
  }
  
  
  if (length(error_parts) > 0) {
    
    combined_errors <- dplyr::bind_rows(
      error_parts
    )
    
  } else {
    
    combined_errors <- empty_error_table()
  }
  
  
  list(
    intersections =
      combined_intersections,
    
    errors =
      combined_errors
  )
}


# ============================================================
# 25. Summarise title classes for one extent
# ============================================================

summarise_titles_for_extent <- function(
    source_extent,
    phu_name,
    extent_type) {
  
  # ----------------------------------------------------------
  # No matching spatial extent
  # ----------------------------------------------------------
  
  if (
    is.null(source_extent) ||
    nrow(source_extent) == 0
  ) {
    
    return(
      list(
        results = make_zero_title_rows(
          phu_name = phu_name,
          extent_type = extent_type,
          extent_area_ha = 0,
          status_text =
            "No matching extent"
        ),
        
        extent_summary = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Extent_area_ha = 0,
          Unique_cadastral_overlap_ha = 0,
          Summed_title_class_area_ha = 0,
          Area_outside_cadastral_ha = 0,
          Potential_overlap_between_title_types_ha = 0,
          Cadastral_coverage_pct = NA_real_,
          Status = "No matching extent"
        ),
        
        errors =
          empty_error_table()
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Repair source extent
  # ----------------------------------------------------------
  
  source_extent <- repair_polygon_geometry(
    spatial_object = source_extent,
    
    object_name = paste(
      phu_name,
      extent_type
    ),
    
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  
  # ----------------------------------------------------------
  # Calculate extent area
  # ----------------------------------------------------------
  
  extent_area_ha <- calculate_area_ha(
    source_extent
  )
  
  
  if (
    is.na(extent_area_ha) ||
    !is.finite(extent_area_ha)
  ) {
    
    error_message <- paste(
      "Could not calculate a valid area for",
      phu_name,
      "-",
      extent_type
    )
    
    return(
      list(
        results = make_zero_title_rows(
          phu_name = phu_name,
          extent_type = extent_type,
          extent_area_ha = NA_real_,
          status_text = error_message
        ),
        
        extent_summary = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Extent_area_ha = NA_real_,
          Unique_cadastral_overlap_ha =
            NA_real_,
          Summed_title_class_area_ha =
            NA_real_,
          Area_outside_cadastral_ha =
            NA_real_,
          Potential_overlap_between_title_types_ha =
            NA_real_,
          Cadastral_coverage_pct =
            NA_real_,
          Status =
            error_message
        ),
        
        errors = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Title_source_ID =
            NA_integer_,
          Title_type =
            NA_character_,
          Error_message =
            error_message
        )
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Select candidate cadastral titles
  # ----------------------------------------------------------
  
  candidate_error <- NULL
  
  candidate_index <- tryCatch(
    which(
      lengths(
        sf::st_intersects(
          cadastral_work,
          source_extent
        )
      ) > 0
    ),
    error = function(e) {
      
      candidate_error <<-
        conditionMessage(e)
      
      integer()
    }
  )
  
  
  if (!is.null(candidate_error)) {
    
    error_message <- paste(
      "Could not select cadastral titles for",
      phu_name,
      "-",
      extent_type,
      ":",
      candidate_error
    )
    
    return(
      list(
        results = make_zero_title_rows(
          phu_name = phu_name,
          extent_type = extent_type,
          extent_area_ha = extent_area_ha,
          status_text = error_message
        ),
        
        extent_summary = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Extent_area_ha = extent_area_ha,
          Unique_cadastral_overlap_ha =
            NA_real_,
          Summed_title_class_area_ha =
            NA_real_,
          Area_outside_cadastral_ha =
            NA_real_,
          Potential_overlap_between_title_types_ha =
            NA_real_,
          Cadastral_coverage_pct =
            NA_real_,
          Status =
            error_message
        ),
        
        errors = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Title_source_ID =
            NA_integer_,
          Title_type =
            NA_character_,
          Error_message =
            error_message
        )
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # No cadastral overlap
  # ----------------------------------------------------------
  
  if (length(candidate_index) == 0) {
    
    return(
      list(
        results = make_zero_title_rows(
          phu_name = phu_name,
          extent_type = extent_type,
          extent_area_ha =
            extent_area_ha,
          status_text =
            "No cadastral overlap"
        ),
        
        extent_summary = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Extent_area_ha = extent_area_ha,
          Unique_cadastral_overlap_ha = 0,
          Summed_title_class_area_ha = 0,
          Area_outside_cadastral_ha =
            extent_area_ha,
          Potential_overlap_between_title_types_ha = 0,
          Cadastral_coverage_pct = 0,
          Status = "No cadastral overlap"
        ),
        
        errors =
          empty_error_table()
      )
    )
  }
  
  
  cadastral_candidates <- cadastral_work[
    candidate_index,
    ,
    drop = FALSE
  ]
  
  
  # ----------------------------------------------------------
  # Intersect titles with the PHU extent
  # ----------------------------------------------------------
  
  intersection_output <-
    intersect_titles_with_extent(
      cadastral_candidates =
        cadastral_candidates,
      
      source_extent =
        source_extent,
      
      phu_name =
        phu_name,
      
      extent_type =
        extent_type
    )
  
  
  title_intersections <-
    intersection_output$intersections
  
  processing_errors <-
    intersection_output$errors
  
  
  if (
    is.null(title_intersections) ||
    nrow(title_intersections) == 0
  ) {
    
    status_text <- if (
      nrow(processing_errors) > 0
    ) {
      
      "No valid cadastral overlap; intersection errors recorded"
      
    } else {
      
      "No positive-area cadastral overlap"
    }
    
    return(
      list(
        results = make_zero_title_rows(
          phu_name = phu_name,
          extent_type = extent_type,
          extent_area_ha =
            extent_area_ha,
          status_text =
            status_text
        ),
        
        extent_summary = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Extent_area_ha = extent_area_ha,
          Unique_cadastral_overlap_ha = 0,
          Summed_title_class_area_ha = 0,
          Area_outside_cadastral_ha =
            extent_area_ha,
          Potential_overlap_between_title_types_ha = 0,
          Cadastral_coverage_pct = 0,
          Status = status_text
        ),
        
        errors =
          processing_errors
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Remove zero-area intersection fragments
  # ----------------------------------------------------------
  
  title_intersections$Fragment_area_ha <-
    suppressWarnings(
      as.numeric(
        sf::st_area(
          title_intersections
        )
      ) / 10000
    )
  
  valid_fragments <- (
    !is.na(
      title_intersections$Fragment_area_ha
    ) &
      is.finite(
        title_intersections$Fragment_area_ha
      ) &
      title_intersections$Fragment_area_ha > 0
  )
  
  title_intersections <- title_intersections[
    valid_fragments,
    ,
    drop = FALSE
  ]
  
  
  if (nrow(title_intersections) == 0) {
    
    return(
      list(
        results = make_zero_title_rows(
          phu_name = phu_name,
          extent_type = extent_type,
          extent_area_ha =
            extent_area_ha,
          status_text =
            "No positive-area cadastral overlap"
        ),
        
        extent_summary = tibble::tibble(
          PHU = phu_name,
          Extent_type = extent_type,
          Extent_area_ha = extent_area_ha,
          Unique_cadastral_overlap_ha = 0,
          Summed_title_class_area_ha = 0,
          Area_outside_cadastral_ha =
            extent_area_ha,
          Potential_overlap_between_title_types_ha = 0,
          Cadastral_coverage_pct = 0,
          Status =
            "No positive-area cadastral overlap"
        ),
        
        errors =
          processing_errors
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Dissolve fragments belonging to the same source title
  #
  # One source title is therefore counted once.
  # ----------------------------------------------------------
  
  parcel_overlap_sf <- title_intersections |>
    dplyr::select(
      Title_source_ID,
      Title_type,
      Title_size_ha
    ) |>
    dplyr::group_by(
      Title_source_ID,
      Title_type,
      Title_size_ha
    ) |>
    dplyr::summarise(
      do_union = TRUE,
      .groups = "drop"
    )
  
  parcel_overlap_sf <- repair_polygon_geometry(
    spatial_object =
      parcel_overlap_sf,
    
    object_name = paste(
      phu_name,
      extent_type,
      "parcel overlaps"
    ),
    
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  
  parcel_overlap <- parcel_overlap_sf |>
    sf::st_drop_geometry()
  
  
  # ----------------------------------------------------------
  # Calculate unique area under each title class
  #
  # Titles within the same class are dissolved so overlapping
  # polygons within one class are not counted twice.
  # ----------------------------------------------------------
  
  title_class_area_sf <- parcel_overlap_sf |>
    dplyr::select(
      Title_type
    ) |>
    dplyr::group_by(
      Title_type
    ) |>
    dplyr::summarise(
      do_union = TRUE,
      .groups = "drop"
    )
  
  title_class_area_sf <-
    repair_polygon_geometry(
      spatial_object =
        title_class_area_sf,
      
      object_name = paste(
        phu_name,
        extent_type,
        "title-class areas"
      ),
      
      use_zero_buffer = TRUE,
      remove_zero_area = TRUE
    )
  
  title_class_area_sf$Total_area_within_extent_ha <-
    suppressWarnings(
      as.numeric(
        sf::st_area(
          title_class_area_sf
        )
      ) / 10000
    )
  
  title_class_area <- title_class_area_sf |>
    sf::st_drop_geometry() |>
    dplyr::select(
      Title_type,
      Total_area_within_extent_ha
    )
  
  
  # ----------------------------------------------------------
  # Counts and block-size statistics
  #
  # Mean, median and size classes use the original "ha" field.
  # ----------------------------------------------------------
  
  title_statistics <- parcel_overlap |>
    dplyr::group_by(
      Title_type
    ) |>
    dplyr::summarise(
      Title_count =
        dplyr::n_distinct(
          Title_source_ID
        ),
      
      Mean_title_size_ha =
        safe_mean(
          Title_size_ha
        ),
      
      Median_title_size_ha =
        safe_median(
          Title_size_ha
        ),
      
      Count_lt_40_46_ha =
        sum(
          !is.na(Title_size_ha) &
            is.finite(Title_size_ha) &
            Title_size_ha < 40.46
        ),
      
      Count_40_46_to_500_ha =
        sum(
          !is.na(Title_size_ha) &
            is.finite(Title_size_ha) &
            Title_size_ha >= 40.46 &
            Title_size_ha <= 500
        ),
      
      Count_gt_500_ha =
        sum(
          !is.na(Title_size_ha) &
            is.finite(Title_size_ha) &
            Title_size_ha > 500
        ),
      
      Count_missing_ha =
        sum(
          is.na(Title_size_ha) |
            !is.finite(Title_size_ha)
        ),
      
      .groups = "drop"
    )
  
  
  title_summary <- dplyr::full_join(
    title_class_area,
    title_statistics,
    by = "Title_type"
  )
  
  
  # ----------------------------------------------------------
  # Add title classes that have no overlap
  # ----------------------------------------------------------
  
  title_template <- tibble::tibble(
    Title_type =
      title_types_to_report
  )
  
  final_results <- title_template |>
    dplyr::left_join(
      title_summary,
      by = "Title_type"
    ) |>
    dplyr::mutate(
      Total_area_within_extent_ha =
        dplyr::coalesce(
          Total_area_within_extent_ha,
          0
        ),
      
      Title_count =
        dplyr::coalesce(
          as.integer(Title_count),
          0L
        ),
      
      Count_missing_ha =
        dplyr::coalesce(
          as.integer(Count_missing_ha),
          0L
        ),
      
      Count_lt_40_46_ha =
        dplyr::case_when(
          Title_type == "TL" ~
            NA_integer_,
          
          is.na(
            Count_lt_40_46_ha
          ) ~
            0L,
          
          TRUE ~
            as.integer(
              Count_lt_40_46_ha
            )
        ),
      
      Count_40_46_to_500_ha =
        dplyr::case_when(
          Title_type == "TL" ~
            NA_integer_,
          
          is.na(
            Count_40_46_to_500_ha
          ) ~
            0L,
          
          TRUE ~
            as.integer(
              Count_40_46_to_500_ha
            )
        ),
      
      Count_gt_500_ha =
        dplyr::case_when(
          Title_type == "TL" ~
            NA_integer_,
          
          is.na(
            Count_gt_500_ha
          ) ~
            0L,
          
          TRUE ~
            as.integer(
              Count_gt_500_ha
            )
        ),
      
      PHU =
        phu_name,
      
      Extent_type =
        extent_type,
      
      Extent_area_ha =
        extent_area_ha
    )
  
  
  if (
    is_positive_area(
      extent_area_ha
    )
  ) {
    
    final_results$Percentage_of_extent <-
      final_results$Total_area_within_extent_ha /
      extent_area_ha *
      100
    
  } else {
    
    final_results$Percentage_of_extent <-
      NA_real_
  }
  
  
  if (nrow(processing_errors) > 0) {
    
    final_results$Status <-
      "Completed with title intersection errors"
    
  } else {
    
    final_results$Status <-
      "Completed"
  }
  
  
  final_results <- final_results |>
    dplyr::select(
      PHU,
      Extent_type,
      Title_type,
      Extent_area_ha,
      Total_area_within_extent_ha,
      Percentage_of_extent,
      Title_count,
      Mean_title_size_ha,
      Median_title_size_ha,
      Count_lt_40_46_ha,
      Count_40_46_to_500_ha,
      Count_gt_500_ha,
      Count_missing_ha,
      Status
    )
  
  
  # ----------------------------------------------------------
  # Unique cadastral coverage
  # ----------------------------------------------------------
  
  unique_cadastral_area_ha <- tryCatch(
    {
      
      union_geometry <- suppressWarnings(
        sf::st_union(
          sf::st_geometry(
            parcel_overlap_sf
          )
        )
      )
      
      union_object <- sf::st_sf(
        union_id = 1,
        geom = union_geometry
      )
      
      sf::st_crs(union_object) <-
        sf::st_crs(parcel_overlap_sf)
      
      calculate_area_ha(
        union_object
      )
    },
    error = function(e) {
      
      NA_real_
    }
  )
  
  
  summed_title_class_area_ha <- sum(
    final_results$Total_area_within_extent_ha,
    na.rm = TRUE
  )
  
  
  if (
    !is.na(unique_cadastral_area_ha) &&
    is.finite(unique_cadastral_area_ha)
  ) {
    
    potential_overlap_ha <- max(
      summed_title_class_area_ha -
        unique_cadastral_area_ha,
      0
    )
    
    area_outside_cadastral_ha <- max(
      extent_area_ha -
        unique_cadastral_area_ha,
      0
    )
    
  } else {
    
    potential_overlap_ha <-
      NA_real_
    
    area_outside_cadastral_ha <-
      NA_real_
  }
  
  
  if (
    is_positive_area(
      extent_area_ha
    ) &&
    !is.na(unique_cadastral_area_ha) &&
    is.finite(unique_cadastral_area_ha)
  ) {
    
    cadastral_coverage_pct <-
      unique_cadastral_area_ha /
      extent_area_ha *
      100
    
  } else {
    
    cadastral_coverage_pct <-
      NA_real_
  }
  
  
  extent_status <- if (
    nrow(processing_errors) > 0
  ) {
    
    "Completed with title intersection errors"
    
  } else {
    
    "Completed"
  }
  
  
  extent_summary <- tibble::tibble(
    PHU = phu_name,
    Extent_type = extent_type,
    Extent_area_ha = extent_area_ha,
    
    Unique_cadastral_overlap_ha =
      unique_cadastral_area_ha,
    
    Summed_title_class_area_ha =
      summed_title_class_area_ha,
    
    Area_outside_cadastral_ha =
      area_outside_cadastral_ha,
    
    Potential_overlap_between_title_types_ha =
      potential_overlap_ha,
    
    Cadastral_coverage_pct =
      cadastral_coverage_pct,
    
    Status =
      extent_status
  )
  
  
  list(
    results =
      final_results,
    
    extent_summary =
      extent_summary,
    
    errors =
      processing_errors
  )
}


# ============================================================
# 26. Process one PHU file
# ============================================================

process_phu_file <- function(gpkg_file) {
  
  phu_name <- tools::file_path_sans_ext(
    basename(gpkg_file)
  )
  
  message(
    "Processing PHU: ",
    phu_name
  )
  
  
  tryCatch(
    {
      
      phu_original <- read_phu_gpkg(
        gpkg_file
      )
      
      phu_work <- prepare_layer_for_analysis(
        spatial_object = phu_original,
        object_name = phu_name
      )
      
      
      total_phu <- prepare_phu_extent(
        phu_data = phu_work,
        soil_associations = NULL,
        extent_name = paste(
          phu_name,
          "total PHU"
        )
      )
      
      
      doa_peat <- prepare_phu_extent(
        phu_data = phu_work,
        soil_associations =
          doa_peat_associations,
        extent_name = paste(
          phu_name,
          "DoA peat"
        )
      )
      
      
      sfd_peat <- prepare_phu_extent(
        phu_data = phu_work,
        soil_associations =
          sfd_peat_associations,
        extent_name = paste(
          phu_name,
          "SFD peat"
        )
      )
      
      
      total_result <- summarise_titles_for_extent(
        source_extent = total_phu,
        phu_name = phu_name,
        extent_type = "Total PHU"
      )
      
      
      doa_result <- summarise_titles_for_extent(
        source_extent = doa_peat,
        phu_name = phu_name,
        extent_type = "DoA peat extent"
      )
      
      
      sfd_result <- summarise_titles_for_extent(
        source_extent = sfd_peat,
        phu_name = phu_name,
        extent_type = "SFD peat extent"
      )
      
      
      list(
        results = dplyr::bind_rows(
          total_result$results,
          doa_result$results,
          sfd_result$results
        ),
        
        extent_summary = dplyr::bind_rows(
          total_result$extent_summary,
          doa_result$extent_summary,
          sfd_result$extent_summary
        ),
        
        errors = dplyr::bind_rows(
          total_result$errors,
          doa_result$errors,
          sfd_result$errors
        )
      )
    },
    
    
    error = function(e) {
      
      phu_error_message <-
        conditionMessage(e)
      
      
      error_results <- dplyr::bind_rows(
        
        make_zero_title_rows(
          phu_name = phu_name,
          extent_type = "Total PHU",
          extent_area_ha = NA_real_,
          status_text = paste(
            "PHU processing error:",
            phu_error_message
          )
        ),
        
        make_zero_title_rows(
          phu_name = phu_name,
          extent_type = "DoA peat extent",
          extent_area_ha = NA_real_,
          status_text = paste(
            "PHU processing error:",
            phu_error_message
          )
        ),
        
        make_zero_title_rows(
          phu_name = phu_name,
          extent_type = "SFD peat extent",
          extent_area_ha = NA_real_,
          status_text = paste(
            "PHU processing error:",
            phu_error_message
          )
        )
      )
      
      
      error_summary <- tibble::tibble(
        PHU = rep(
          phu_name,
          3
        ),
        
        Extent_type = c(
          "Total PHU",
          "DoA peat extent",
          "SFD peat extent"
        ),
        
        Extent_area_ha =
          NA_real_,
        
        Unique_cadastral_overlap_ha =
          NA_real_,
        
        Summed_title_class_area_ha =
          NA_real_,
        
        Area_outside_cadastral_ha =
          NA_real_,
        
        Potential_overlap_between_title_types_ha =
          NA_real_,
        
        Cadastral_coverage_pct =
          NA_real_,
        
        Status = paste(
          "PHU processing error:",
          phu_error_message
        )
      )
      
      
      error_table <- tibble::tibble(
        PHU = phu_name,
        Extent_type =
          "All PHU extents",
        Title_source_ID =
          NA_integer_,
        Title_type =
          NA_character_,
        Error_message =
          phu_error_message
      )
      
      
      list(
        results =
          error_results,
        
        extent_summary =
          error_summary,
        
        errors =
          error_table
      )
    }
  )
}


