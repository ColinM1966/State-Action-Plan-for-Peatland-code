# ============================================================
# 15. Prepare and dissolve a PHU extent
#
# soil_associations = NULL gives the full PHU.
# ============================================================

prepare_phu_extent <- function(
    phu_data,
    soil_associations = NULL,
    extent_name = "PHU extent") {
  
  extent_data <- phu_data
  
  if (!is.null(soil_associations)) {
    
    selected_rows <- matches_soil_association(
      soil_values =
        extent_data$SO_ASSOCIA,
      target_associations =
        soil_associations
    )
    
    selected_rows[
      is.na(selected_rows)
    ] <- FALSE
    
    extent_data <- extent_data[
      selected_rows,
      ,
      drop = FALSE
    ]
  }
  
  if (nrow(extent_data) == 0) {
    
    return(NULL)
  }
  
  extent_data <- repair_polygon_geometry(
    spatial_object = extent_data,
    object_name = extent_name,
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  if (nrow(extent_data) == 0) {
    
    return(NULL)
  }
  
  dissolved_geometry <- suppressWarnings(
    sf::st_union(
      sf::st_geometry(
        extent_data
      )
    )
  )
  
  dissolved_extent <- sf::st_sf(
    extent_id = 1,
    geom = dissolved_geometry
  )
  
  sf::st_crs(dissolved_extent) <-
    sf::st_crs(extent_data)
  
  dissolved_extent <- repair_polygon_geometry(
    spatial_object = dissolved_extent,
    object_name = paste(
      extent_name,
      "dissolved"
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  dissolved_extent
}


# ============================================================
# 16. Calculate area in hectares
# ============================================================

calculate_area_ha <- function(spatial_object) {
  
  if (
    is.null(spatial_object) ||
    nrow(spatial_object) == 0
  ) {
    
    return(0)
  }
  
  area_values <- suppressWarnings(
    as.numeric(
      sf::st_area(
        spatial_object
      )
    )
  )
  
  valid_area_values <- (
    !is.na(area_values) &
      is.finite(area_values) &
      area_values >= 0
  )
  
  if (!any(valid_area_values)) {
    
    return(NA_real_)
  }
  
  sum(
    area_values[valid_area_values],
    na.rm = TRUE
  ) / 10000
}


# ============================================================
# 17. Safe mean and median
# ============================================================

safe_mean <- function(x) {
  
  valid_values <- x[
    !is.na(x) &
      is.finite(x)
  ]
  
  if (length(valid_values) == 0) {
    
    return(NA_real_)
  }
  
  mean(valid_values)
}


safe_median <- function(x) {
  
  valid_values <- x[
    !is.na(x) &
      is.finite(x)
  ]
  
  if (length(valid_values) == 0) {
    
    return(NA_real_)
  }
  
  median(valid_values)
}


