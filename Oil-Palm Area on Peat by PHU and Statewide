    paste(
      "The oil-palm polygons could not be dissolved.",
      "Check the geometry of OilPalm_FTC24.gpkg."
    )
  )
}

oil_palm_footprint <- sf::st_sf(
  gridcode = oil_palm_gridcode,
  geom = oil_palm_union_geometry
)

sf::st_crs(oil_palm_footprint) <-
  sf::st_crs(oil_palm_work)

oil_palm_footprint <- repair_polygon_geometry(
  spatial_object = oil_palm_footprint,
  object_name =
    "Dissolved oil-palm footprint",
  use_zero_buffer = TRUE,
  remove_zero_area = TRUE
)

if (nrow(oil_palm_footprint) == 0) {
  
  stop(
    paste(
      "No usable oil-palm geometry remained",
      "after dissolving and repairing gridcode 8."
    )
  )
}

