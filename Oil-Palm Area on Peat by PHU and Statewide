# ============================================================
# 7. Text-cleaning functions
# ============================================================

clean_text <- function(x) {
  
  x |>
    as.character() |>
    stringr::str_squish() |>
    stringr::str_to_upper()
}


normalise_field_name <- function(x) {
  
  x |>
    as.character() |>
    stringr::str_to_upper() |>
    stringr::str_replace_all(
      "[^A-Z0-9]",
      ""
    )
}


# ============================================================
# 8. Find a field using possible names
# ============================================================

find_field_name <- function(
    spatial_object,
    possible_names) {
  
  existing_names <- names(
    spatial_object
  )
  
  existing_normalised <- normalise_field_name(
    existing_names
  )
  
  possible_normalised <- normalise_field_name(
    possible_names
  )
  
  matching_position <- which(
    existing_normalised %in%
      possible_normalised
  )
  
  if (length(matching_position) == 0) {
    
    return(NA_character_)
  }
  
  existing_names[
    matching_position[1]
  ]
}


# ============================================================
# 9. Standardise a field name
# ============================================================

standardise_field_name <- function(
    spatial_object,
    possible_names,
    new_name) {
  
  existing_field <- find_field_name(
    spatial_object,
    possible_names
  )
  
  if (is.na(existing_field)) {
    
    stop(
      paste(
        "Could not find required field.",
        "Expected one of:",
        paste(
          possible_names,
          collapse = ", "
        )
      )
    )
  }
  
  if (existing_field != new_name) {
    
    names(spatial_object)[
      names(spatial_object) ==
        existing_field
    ] <- new_name
  }
  
  spatial_object
}


# ============================================================
# 10. Match soil-association values
#
# Supports values such as:
#   Klias
#   Klias Association
#   KLIAS SOIL ASSOCIATION
#   Klias / Sipitang
# ============================================================

matches_soil_association <- function(
    soil_values,
    target_associations) {
  
  cleaned_values <- clean_text(
    soil_values
  )
  
  association_pattern <- paste0(
    "\\b(",
    paste(
      target_associations,
      collapse = "|"
    ),
    ")\\b"
  )
  
  !is.na(cleaned_values) &
    stringr::str_detect(
      cleaned_values,
      association_pattern
    )
}


# ============================================================
# 11. Repair polygon geometry
# ============================================================

repair_polygon_geometry <- function(
    spatial_object,
    object_name = "spatial object",
    use_zero_buffer = FALSE,
    remove_zero_area = FALSE) {
  
  if (!inherits(spatial_object, "sf")) {
    
    stop(
      paste(
        object_name,
        "is not an sf object."
      )
    )
  }
  
  if (is.na(sf::st_crs(spatial_object))) {
    
    stop(
      paste(
        object_name,
        "does not have a defined CRS."
      )
    )
  }
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # Remove Z and M dimensions
  # ----------------------------------------------------------
  
  spatial_object <- suppressWarnings(
    sf::st_zm(
      spatial_object,
      drop = TRUE,
      what = "ZM"
    )
  )
  
  
  # ----------------------------------------------------------
  # Remove missing geometries
  # ----------------------------------------------------------
  
  missing_geometry <- is.na(
    sf::st_geometry(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !missing_geometry,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # Remove empty geometries
  # ----------------------------------------------------------
  
  empty_geometry <- tryCatch(
    sf::st_is_empty(
      spatial_object
    ),
    error = function(e) {
      
      rep(
        FALSE,
        nrow(spatial_object)
      )
    }
  )
  
  spatial_object <- spatial_object[
    !empty_geometry,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # First validity repair
  # ----------------------------------------------------------
  
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  
  # ----------------------------------------------------------
  # Remove geometry lost during repair
  # ----------------------------------------------------------
  
  spatial_object <- spatial_object[
    !is.na(
      sf::st_geometry(
        spatial_object
      )
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  spatial_object <- spatial_object[
    !sf::st_is_empty(
      spatial_object
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # Extract polygons from geometry collections
  # ----------------------------------------------------------
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  if (
    any(
      geometry_types ==
      "GEOMETRYCOLLECTION"
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON"
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Retain polygon geometry only
  # ----------------------------------------------------------
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  polygon_rows <- geometry_types %in%
    c(
      "POLYGON",
      "MULTIPOLYGON"
    )
  
  spatial_object <- spatial_object[
    polygon_rows,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # Optional zero-distance buffer
  #
  # This is only used after transformation to a projected CRS.
  # ----------------------------------------------------------
  
  if (use_zero_buffer) {
    
    buffered_object <- tryCatch(
      suppressWarnings(
        sf::st_buffer(
          spatial_object,
          dist = 0
        )
      ),
      error = function(e) {
        
        NULL
      }
    )
    
    if (!is.null(buffered_object)) {
      
      spatial_object <- buffered_object
    }
  }
  
  
  # ----------------------------------------------------------
  # Final validity repair
  # ----------------------------------------------------------
  
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !is.na(
      sf::st_geometry(
        spatial_object
      )
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  spatial_object <- spatial_object[
    !sf::st_is_empty(
      spatial_object
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # Extract polygon components again if required
  # ----------------------------------------------------------
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  if (
    any(
      geometry_types ==
      "GEOMETRYCOLLECTION"
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON"
      )
    )
  }
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    geometry_types %in%
      c(
        "POLYGON",
        "MULTIPOLYGON"
      ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    
    return(spatial_object)
  }
  
  
  # ----------------------------------------------------------
  # Remove zero-area remnants
  # ----------------------------------------------------------
  
  if (remove_zero_area) {
    
    polygon_area <- tryCatch(
      as.numeric(
        sf::st_area(
          spatial_object
        )
      ),
      error = function(e) {
        
        rep(
          NA_real_,
          nrow(spatial_object)
        )
      }
    )
    
    keep_rows <- (
      is.finite(polygon_area) &
        polygon_area > 0
    )
    
    spatial_object <- spatial_object[
      keep_rows,
      ,
      drop = FALSE
    ]
  }
  
  spatial_object
}


# ============================================================
# 12. Prepare a layer in the analysis CRS
# ============================================================

prepare_layer_for_analysis <- function(
    spatial_object,
    object_name) {
  
  spatial_object <- repair_polygon_geometry(
    spatial_object = spatial_object,
    object_name = paste(
      object_name,
      "before transformation"
    ),
    use_zero_buffer = FALSE,
    remove_zero_area = FALSE
  )
  
  if (nrow(spatial_object) == 0) {
    
    stop(
      paste(
        object_name,
        "contains no usable polygon geometry."
      )
    )
  }
  
  spatial_object <- sf::st_transform(
    spatial_object,
    crs = analysis_crs
  )
  
  spatial_object <- repair_polygon_geometry(
    spatial_object = spatial_object,
    object_name = paste(
      object_name,
      "in analysis CRS"
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  if (nrow(spatial_object) == 0) {
    
    stop(
      paste(
        object_name,
        "contains no usable polygons after transformation."
      )
    )
  }
  
  spatial_object
}


# ============================================================
# 13. Read the oil-palm polygon layer
#
# Searches all GeoPackage layers for a polygon layer containing
# gridcode.
# ============================================================

read_oil_palm_gpkg <- function(gpkg_path) {
  
  layer_names <- sf::st_layers(
    gpkg_path
  )$name
  
  if (length(layer_names) == 0) {
    
    stop(
      paste(
        "No layers were found in:",
        gpkg_path
      )
    )
  }
  
  for (layer_name in layer_names) {
    
    layer_object <- tryCatch(
      sf::st_read(
        dsn = gpkg_path,
        layer = layer_name,
        quiet = TRUE,
        stringsAsFactors = FALSE
      ),
      error = function(e) {
        
        NULL
      }
    )
    
    if (
      is.null(layer_object) ||
      !inherits(layer_object, "sf") ||
      nrow(layer_object) == 0
    ) {
      
      next
    }
    
    gridcode_field <- find_field_name(
      layer_object,
      c(
        "gridcode",
        "grid_code",
        "grid code"
      )
    )
    
    if (is.na(gridcode_field)) {
      
      next
    }
    
    geometry_types <- unique(
      as.character(
        sf::st_geometry_type(
          layer_object
        )
      )
    )
    
    acceptable_types <- c(
      "POLYGON",
      "MULTIPOLYGON",
      "GEOMETRYCOLLECTION"
    )
    
    if (
      any(
        geometry_types %in%
        acceptable_types
      )
    ) {
      
      message(
        "Oil-palm layer selected: ",
        layer_name
      )
      
      layer_object <- standardise_field_name(
        spatial_object = layer_object,
        possible_names = c(
          "gridcode",
          "grid_code",
          "grid code"
        ),
        new_name = "gridcode"
      )
      
      return(layer_object)
    }
  }
  
  stop(
    paste(
      "No polygon layer containing gridcode",
      "was found in:",
      gpkg_path
    )
  )
}


