# ============================================================
# 22. Dissolve oil-palm polygons
#
# This ensures overlapping oil-palm polygons are not counted
# more than once.
# ============================================================

message(
  "Dissolving oil-palm polygons..."
)

oil_palm_union_geometry <- tryCatch(
  suppressWarnings(
    sf::st_union(
      sf::st_geometry(
        oil_palm_work
      )
    )
  ),
  error = function(e) {
    
    NULL
  }
)

if (is.null(oil_palm_union_geometry)) {
  
