# ============================================================
# 15. Prepare and dissolve a peat extent
# ============================================================

prepare_peat_extent <- function(
    spatial_data,
    soil_associations,
    extent_name) {
  
  selected_rows <- matches_soil_association(
    soil_values =
      spatial_data$SO_ASSOCIA,
    target_associations =
      soil_associations
  )
  
  extent_data <- spatial_data[
    selected_rows,
    ,
    drop = FALSE
  ]
  
  if (nrow(extent_data) == 0) {
    
    return(NULL)
  }
  
  extent_data <- repair_polygon_geometry(
    spatial_object = extent_data,
    object_name = extent_name,
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  if (nrow(extent_data) == 0) {
    
    return(NULL)
  }
  
  dissolved_geometry <- suppressWarnings(
    sf::st_union(
      sf::st_geometry(
        extent_data
      )
    )
  )
  
  dissolved_extent <- sf::st_sf(
    extent_id = 1,
    geom = dissolved_geometry
  )
  
  sf::st_crs(dissolved_extent) <-
    sf::st_crs(extent_data)
  
  dissolved_extent <- repair_polygon_geometry(
    spatial_object = dissolved_extent,
    object_name = paste(
      extent_name,
      "dissolved"
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  dissolved_extent
}


# ============================================================
# 16. Calculate area in hectares
# ============================================================

calculate_area_ha <- function(spatial_object) {
  
  if (
    is.null(spatial_object) ||
    nrow(spatial_object) == 0
  ) {
    
    return(0)
  }
  
  sum(
    as.numeric(
      sf::st_area(
        spatial_object
      )
    ),
    na.rm = TRUE
  ) / 10000
}


# ============================================================
# 17. Safely intersect two polygon extents
# ============================================================

safe_polygon_intersection <- function(
    first_object,
    second_object,
    intersection_name) {
  
  intersection_geometry <- tryCatch(
    suppressWarnings(
      sf::st_intersection(
        sf::st_geometry(
          first_object
        ),
        sf::st_geometry(
          second_object
        )
      )
    ),
    error = function(e) {
      
      NULL
    }
  )
  
  if (
    !is.null(intersection_geometry) &&
    length(intersection_geometry) > 0
  ) {
    
    intersection_object <- sf::st_sf(
      geom = intersection_geometry
    )
    
    sf::st_crs(intersection_object) <-
      sf::st_crs(first_object)
    
    intersection_object <- tryCatch(
      repair_polygon_geometry(
        spatial_object = intersection_object,
        object_name = intersection_name,
        use_zero_buffer = TRUE,
        remove_zero_area = TRUE
      ),
      error = function(e) {
        
        NULL
      }
    )
    
    if (
      !is.null(intersection_object) &&
      nrow(intersection_object) > 0
    ) {
      
      return(intersection_object)
    }
  }
  
  
  # ----------------------------------------------------------
  # Second attempt after repairing both source objects
  # ----------------------------------------------------------
  
  first_repaired <- tryCatch(
    repair_polygon_geometry(
      spatial_object = first_object,
      object_name = paste(
        intersection_name,
        "first input retry"
      ),
      use_zero_buffer = TRUE,
      remove_zero_area = TRUE
    ),
    error = function(e) {
      
      NULL
    }
  )
  
  second_repaired <- tryCatch(
    repair_polygon_geometry(
      spatial_object = second_object,
      object_name = paste(
        intersection_name,
        "second input retry"
      ),
      use_zero_buffer = TRUE,
      remove_zero_area = TRUE
    ),
    error = function(e) {
      
      NULL
    }
  )
  
  if (
    is.null(first_repaired) ||
    is.null(second_repaired) ||
    nrow(first_repaired) == 0 ||
    nrow(second_repaired) == 0
  ) {
    
    return(NULL)
  }
  
  intersection_geometry <- tryCatch(
    suppressWarnings(
      sf::st_intersection(
        sf::st_geometry(
          first_repaired
        ),
        sf::st_geometry(
          second_repaired
        )
      )
    ),
    error = function(e) {
      
      NULL
    }
  )
  
  if (
    is.null(intersection_geometry) ||
    length(intersection_geometry) == 0
  ) {
    
    return(NULL)
  }
  
  intersection_object <- sf::st_sf(
    geom = intersection_geometry
  )
  
  sf::st_crs(intersection_object) <-
    sf::st_crs(first_repaired)
  
  intersection_object <- tryCatch(
    repair_polygon_geometry(
      spatial_object = intersection_object,
      object_name = paste(
        intersection_name,
        "retry result"
      ),
      use_zero_buffer = TRUE,
      remove_zero_area = TRUE
    ),
    error = function(e) {
      
      NULL
    }
  )
  
  intersection_object
}


