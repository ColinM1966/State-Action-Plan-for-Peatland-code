    1
  ),
  "ha\n\n"
)


# ============================================================
# 23. Summarise oil palm on one peat extent
# ============================================================

summarise_oil_palm_on_peat <- function(
    peat_extent,
    scope_name,
    area_name,
    peat_definition) {
  
  if (
    is.null(peat_extent) ||
    nrow(peat_extent) == 0
  ) {
    
    return(
      tibble::tibble(
        Scope = scope_name,
        Area_name = area_name,
        Peat_definition = peat_definition,
        Peat_area_ha = 0,
        Oil_palm_on_peat_ha = 0,
        Peat_not_mapped_as_oil_palm_ha = 0,
        Peat_under_oil_palm_pct = NA_real_,
        Status = "No matching peat extent"
      )
    )
  }
  
  peat_extent <- repair_polygon_geometry(
    spatial_object = peat_extent,
    object_name = paste(
      area_name,
      peat_definition
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  peat_area_ha <- calculate_area_ha(
    peat_extent
  )
  
  intersection_exists <- tryCatch(
    lengths(
      sf::st_intersects(
        peat_extent,
        oil_palm_footprint
      )
    ) > 0,
    error = function(e) {
      
      FALSE
    }
  )
  
  if (!any(intersection_exists)) {
    
    return(
      tibble::tibble(
        Scope = scope_name,
        Area_name = area_name,
        Peat_definition = peat_definition,
        Peat_area_ha = peat_area_ha,
        Oil_palm_on_peat_ha = 0,
        Peat_not_mapped_as_oil_palm_ha =
          peat_area_ha,
        Peat_under_oil_palm_pct = 0,
        Status = "No oil-palm overlap"
      )
    )
  }
  
  peat_oil_palm_intersection <-
    safe_polygon_intersection(
      first_object = peat_extent,
      second_object = oil_palm_footprint,
      intersection_name = paste(
        area_name,
        peat_definition,
        "oil-palm overlap"
      )
    )
  
  if (
    is.null(peat_oil_palm_intersection) ||
    nrow(peat_oil_palm_intersection) == 0
  ) {
    
    return(
      tibble::tibble(
        Scope = scope_name,
        Area_name = area_name,
        Peat_definition = peat_definition,
        Peat_area_ha = peat_area_ha,
        Oil_palm_on_peat_ha = NA_real_,
        Peat_not_mapped_as_oil_palm_ha =
          NA_real_,
        Peat_under_oil_palm_pct =
          NA_real_,
        Status =
          "Intersection failed after geometry repair"
      )
    )
  }
  
  oil_palm_on_peat_ha <- calculate_area_ha(
    peat_oil_palm_intersection
  )
  
  # Prevent very small numerical errors from creating
  # negative remaining areas.
  peat_not_oil_palm_ha <- max(
    peat_area_ha -
      oil_palm_on_peat_ha,
    0
  )
  
  peat_under_oil_palm_pct <- if (
    peat_area_ha > 0
  ) {
    
    oil_palm_on_peat_ha /
      peat_area_ha *
      100
    
  } else {
    
    NA_real_
  }
  
  tibble::tibble(
    Scope = scope_name,
    Area_name = area_name,
    Peat_definition = peat_definition,
    Peat_area_ha = peat_area_ha,
    Oil_palm_on_peat_ha =
      oil_palm_on_peat_ha,
    Peat_not_mapped_as_oil_palm_ha =
      peat_not_oil_palm_ha,
    Peat_under_oil_palm_pct =
      peat_under_oil_palm_pct,
    Status = "Completed"
  )
}


# ============================================================
# 24. Process one PHU
# ============================================================

process_phu_file <- function(gpkg_file) {
  
  phu_name <- tools::file_path_sans_ext(
    basename(gpkg_file)
  )
  
  message(
    "Processing PHU: ",
    phu_name
  )
  
  tryCatch(
    {
      
      phu_original <- read_phu_gpkg(
        gpkg_file
      )
      
      phu_work <- prepare_layer_for_analysis(
        spatial_object = phu_original,
        object_name = phu_name
      )
      
      phu_doa_peat <- prepare_peat_extent(
        spatial_data = phu_work,
        soil_associations =
          doa_peat_associations,
        extent_name = paste(
          phu_name,
          "DoA peat"
        )
      )
      
      phu_sfd_peat <- prepare_peat_extent(
        spatial_data = phu_work,
        soil_associations =
          sfd_peat_associations,
        extent_name = paste(
          phu_name,
          "SFD peat"
        )
      )
      
      dplyr::bind_rows(
        
        summarise_oil_palm_on_peat(
          peat_extent = phu_doa_peat,
          scope_name = "PHU",
          area_name = phu_name,
          peat_definition =
            "DoA peat extent"
        ),
        
        summarise_oil_palm_on_peat(
          peat_extent = phu_sfd_peat,
          scope_name = "PHU",
          area_name = phu_name,
          peat_definition =
            "SFD peat extent"
        )
      )
    },
    error = function(e) {
      
      tibble::tibble(
        Scope = "PHU",
        Area_name = phu_name,
        Peat_definition =
          "Processing error",
        Peat_area_ha = NA_real_,
        Oil_palm_on_peat_ha =
          NA_real_,
        Peat_not_mapped_as_oil_palm_ha =
          NA_real_,
        Peat_under_oil_palm_pct =
          NA_real_,
        Status = conditionMessage(e)
      )
    }
  )
}


