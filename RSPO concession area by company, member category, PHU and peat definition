  footprint_id = 1,
  geom = all_rspo_union
)

sf::st_crs(rspo_footprint) <-
  sf::st_crs(rspo_by_company)

rspo_footprint <- repair_polygon_geometry(
  spatial_object = rspo_footprint,
  object_name = "Complete RSPO footprint",
  use_zero_buffer = TRUE,
  remove_zero_area = TRUE
)


# ============================================================
# 22. Summarise company overlaps for one extent
# ============================================================

summarise_company_overlap <- function(
    source_extent,
    scope_name,
    area_name,
    extent_type) {
  
  if (
    is.null(source_extent) ||
    nrow(source_extent) == 0
  ) {
    
    summary_row <- tibble::tibble(
      Scope = scope_name,
      Area_name = area_name,
      Extent_type = extent_type,
      Extent_area_ha = 0,
      Candidate_company_groups = 0L,
      Successful_company_groups = 0L,
      Unique_RSPO_overlap_ha = 0,
      Summed_company_overlap_ha = 0,
      Potential_overlap_between_company_groups_ha = 0,
      Unique_RSPO_overlap_pct_of_extent = NA_real_,
      Status = "No matching extent"
    )
    
    return(
      list(
        results = empty_overlap_results(),
        summary = summary_row,
        errors = empty_processing_errors()
      )
    )
  }
  
  source_extent <- repair_polygon_geometry(
    spatial_object = source_extent,
    object_name = paste(
      area_name,
      extent_type
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  extent_area_ha <- calculate_area_ha(
    source_extent
  )
  
  candidate_index <- tryCatch(
    which(
      lengths(
        sf::st_intersects(
          rspo_by_company,
          source_extent
        )
      ) > 0
    ),
    error = function(e) {
      integer()
    }
  )
  
  if (length(candidate_index) == 0) {
    
    summary_row <- tibble::tibble(
      Scope = scope_name,
      Area_name = area_name,
      Extent_type = extent_type,
      Extent_area_ha = extent_area_ha,
      Candidate_company_groups = 0L,
      Successful_company_groups = 0L,
      Unique_RSPO_overlap_ha = 0,
      Summed_company_overlap_ha = 0,
      Potential_overlap_between_company_groups_ha = 0,
      Unique_RSPO_overlap_pct_of_extent = 0,
      Status = "No RSPO overlap"
    )
    
    return(
      list(
        results = empty_overlap_results(),
        summary = summary_row,
        errors = empty_processing_errors()
      )
    )
  }
  
  candidate_companies <- rspo_by_company[
    candidate_index,
    ,
    drop = FALSE
  ]
  
  result_parts <- vector(
    mode = "list",
    length = nrow(candidate_companies)
  )
  
  error_parts <- vector(
    mode = "list",
    length = nrow(candidate_companies)
  )
  
  for (
    company_number in
    seq_len(nrow(candidate_companies))
  ) {
    
    company_feature <- candidate_companies[
      company_number,
      ,
      drop = FALSE
    ]
    
    company_name <- as.character(
      company_feature$Parent_company[1]
    )
    
    member_category <- as.character(
      company_feature$Member_category[1]
    )
    
    company_total_area <- as.numeric(
      company_feature$Company_concession_area_ha[1]
    )
    
    intersection_error <- NA_character_
    
    intersection_geometry <- tryCatch(
      suppressWarnings(
        sf::st_intersection(
          sf::st_geometry(
            company_feature
          ),
          sf::st_geometry(
            source_extent
          )
        )
      ),
      error = function(e) {
        
        intersection_error <<-
          conditionMessage(e)
        
        NULL
      }
    )
    
    if (
      is.null(intersection_geometry) ||
      length(intersection_geometry) == 0
    ) {
      
      if (!is.na(intersection_error)) {
        
        error_parts[[company_number]] <-
          tibble::tibble(
            Scope = scope_name,
            Area_name = area_name,
            Extent_type = extent_type,
            Parent_company = company_name,
            Member_category =
              member_category,
            Error_message =
              intersection_error
          )
      }
      
      next
    }
    
    intersection_object <- sf::st_sf(
      geom = intersection_geometry
    )
    
    sf::st_crs(intersection_object) <-
      sf::st_crs(source_extent)
    
    intersection_object <- tryCatch(
      repair_polygon_geometry(
        spatial_object =
          intersection_object,
        object_name = paste(
          company_name,
          area_name,
          extent_type
        ),
        use_zero_buffer = TRUE,
        remove_zero_area = TRUE
      ),
      error = function(e) {
        
        intersection_error <<-
          conditionMessage(e)
        
        NULL
      }
    )
    
    if (
      is.null(intersection_object) ||
      nrow(intersection_object) == 0
    ) {
      
      if (!is.na(intersection_error)) {
        
        error_parts[[company_number]] <-
          tibble::tibble(
            Scope = scope_name,
            Area_name = area_name,
            Extent_type = extent_type,
            Parent_company = company_name,
            Member_category =
              member_category,
            Error_message =
              intersection_error
          )
      }
      
      next
    }
    
    overlap_area_ha <- calculate_area_ha(
      intersection_object
    )
    
    if (
      !is.finite(overlap_area_ha) ||
      overlap_area_ha <= 0
    ) {
      next
    }
    
    result_parts[[company_number]] <-
      tibble::tibble(
        Scope = scope_name,
        Area_name = area_name,
        Extent_type = extent_type,
        Parent_company = company_name,
        Member_category =
          member_category,
        Extent_area_ha =
          extent_area_ha,
        Company_concession_area_ha =
          company_total_area,
        Overlap_area_ha =
          overlap_area_ha,
        Percentage_of_extent =
          ifelse(
            extent_area_ha > 0,
            overlap_area_ha /
              extent_area_ha *
              100,
            NA_real_
          ),
        Percentage_of_company_concession =
          ifelse(
            company_total_area > 0,
            overlap_area_ha /
              company_total_area *
              100,
            NA_real_
          )
      )
  }
  
  result_parts <- Filter(
    Negate(is.null),
    result_parts
  )
  
  error_parts <- Filter(
    Negate(is.null),
    error_parts
  )
  
  if (length(result_parts) > 0) {
    
    company_results <- dplyr::bind_rows(
      result_parts
    )
    
  } else {
    
    company_results <-
      empty_overlap_results()
  }
  
  if (length(error_parts) > 0) {
    
    processing_errors <- dplyr::bind_rows(
      error_parts
    )
    
  } else {
    
    processing_errors <-
      empty_processing_errors()
  }
  
  
  # ----------------------------------------------------------
  # Calculate unique RSPO area in the extent
  # ----------------------------------------------------------
  
  unique_overlap_error <- NA_character_
  
  unique_overlap_geometry <- tryCatch(
    suppressWarnings(
      sf::st_intersection(
        sf::st_geometry(
          rspo_footprint
        ),
        sf::st_geometry(
          source_extent
        )
      )
    ),
    error = function(e) {
      
      unique_overlap_error <<-
        conditionMessage(e)
      
      NULL
    }
  )
  
  if (
    is.null(unique_overlap_geometry) ||
    length(unique_overlap_geometry) == 0
  ) {
    
    unique_rspo_area_ha <- 0
    
  } else {
    
    unique_overlap_object <- sf::st_sf(
      geom = unique_overlap_geometry
    )
    
    sf::st_crs(unique_overlap_object) <-
      sf::st_crs(source_extent)
    
    unique_overlap_object <-
      repair_polygon_geometry(
        spatial_object =
          unique_overlap_object,
        object_name = paste(
          area_name,
          extent_type,
          "unique RSPO overlap"
        ),
        use_zero_buffer = TRUE,
        remove_zero_area = TRUE
      )
    
    unique_rspo_area_ha <- calculate_area_ha(
      unique_overlap_object
    )
  }
  
  summed_company_overlap_ha <- sum(
    company_results$Overlap_area_ha,
    na.rm = TRUE
  )
  
  overlap_between_groups <- max(
    summed_company_overlap_ha -
      unique_rspo_area_ha,
    0
  )
  
  summary_status <- if (
    !is.na(unique_overlap_error)
  ) {
    
    paste(
      "Unique-overlap calculation warning:",
      unique_overlap_error
    )
    
  } else if (
    nrow(processing_errors) > 0
  ) {
    
    "Completed with company intersection errors"
    
  } else {
    
    "Completed"
  }
  
  summary_row <- tibble::tibble(
    Scope = scope_name,
    Area_name = area_name,
    Extent_type = extent_type,
    Extent_area_ha = extent_area_ha,
    Candidate_company_groups =
      nrow(candidate_companies),
    Successful_company_groups =
      nrow(company_results),
    Unique_RSPO_overlap_ha =
      unique_rspo_area_ha,
    Summed_company_overlap_ha =
      summed_company_overlap_ha,
    Potential_overlap_between_company_groups_ha =
      overlap_between_groups,
    Unique_RSPO_overlap_pct_of_extent =
      ifelse(
        extent_area_ha > 0,
        unique_rspo_area_ha /
          extent_area_ha *
          100,
        NA_real_
      ),
    Status = summary_status
  )
  
  list(
    results = company_results,
    summary = summary_row,
    errors = processing_errors
  )
}


