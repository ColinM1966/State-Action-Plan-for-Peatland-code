# 23. Process one PHU
# ============================================================

process_phu_file <- function(gpkg_file) {
  
  phu_name <- tools::file_path_sans_ext(
    basename(gpkg_file)
  )
  
  message(
    "Processing PHU: ",
    phu_name
  )
  
  tryCatch(
    {
      
      phu_original <- read_phu_gpkg(
        gpkg_file
      )
      
      phu_work <- prepare_layer_for_analysis(
        spatial_object = phu_original,
        object_name = phu_name
      )
      
      total_phu <- prepare_extent(
        spatial_data = phu_work,
        soil_associations = NULL,
        extent_name = paste(
          phu_name,
          "total PHU"
        )
      )
      
      doa_peat <- prepare_extent(
        spatial_data = phu_work,
        soil_associations =
          doa_peat_associations,
        extent_name = paste(
          phu_name,
          "DoA peat"
        )
      )
      
      sfd_peat <- prepare_extent(
        spatial_data = phu_work,
        soil_associations =
          sfd_peat_associations,
        extent_name = paste(
          phu_name,
          "SFD peat"
        )
      )
      
      total_result <- summarise_company_overlap(
        source_extent = total_phu,
        scope_name = "PHU",
        area_name = phu_name,
        extent_type = "Total PHU"
      )
      
      doa_result <- summarise_company_overlap(
        source_extent = doa_peat,
        scope_name = "PHU",
        area_name = phu_name,
        extent_type = "DoA peat extent"
      )
      
      sfd_result <- summarise_company_overlap(
        source_extent = sfd_peat,
        scope_name = "PHU",
        area_name = phu_name,
        extent_type = "SFD peat extent"
      )
      
      list(
        results = dplyr::bind_rows(
          total_result$results,
          doa_result$results,
          sfd_result$results
        ),
        summary = dplyr::bind_rows(
          total_result$summary,
          doa_result$summary,
          sfd_result$summary
        ),
        errors = dplyr::bind_rows(
          total_result$errors,
          doa_result$errors,
          sfd_result$errors
        )
      )
    },
    error = function(e) {
      
      list(
        results = empty_overlap_results(),
        
        summary = tibble::tibble(
          Scope = "PHU",
          Area_name = phu_name,
          Extent_type =
            "All PHU extents",
          Extent_area_ha = NA_real_,
          Candidate_company_groups =
            NA_integer_,
          Successful_company_groups =
            NA_integer_,
          Unique_RSPO_overlap_ha =
            NA_real_,
          Summed_company_overlap_ha =
            NA_real_,
          Potential_overlap_between_company_groups_ha =
            NA_real_,
          Unique_RSPO_overlap_pct_of_extent =
            NA_real_,
          Status = paste(
            "PHU processing error:",
            conditionMessage(e)
          )
        ),
        
        errors = tibble::tibble(
          Scope = "PHU",
          Area_name = phu_name,
          Extent_type =
            "All PHU extents",
          Parent_company =
            NA_character_,
          Member_category =
            NA_character_,
          Error_message =
            conditionMessage(e)
        )
      )
    }
  )
}


