# ============================================================
# 20. Dissolve concessions by parent company and category
#
# This prevents overlapping concessions belonging to the same
# company/category from being counted twice.
# ============================================================

message(
  "Dissolving RSPO concessions by company and member category..."
)

rspo_by_company <- rspo_work |>
  dplyr::select(
    Parent_company,
    Member_category
  ) |>
  dplyr::group_by(
    Parent_company,
    Member_category
  ) |>
  dplyr::summarise(
    do_union = TRUE,
    .groups = "drop"
  )

