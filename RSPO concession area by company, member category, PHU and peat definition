# ============================================================
# 7. Text-cleaning functions
# ============================================================

clean_text <- function(x) {
  
  x |>
    as.character() |>
    stringr::str_squish() |>
    stringr::str_to_upper()
}


clean_category_value <- function(x) {
  
  cleaned <- x |>
    as.character() |>
    stringr::str_squish()
  
  cleaned[
    is.na(cleaned) |
      cleaned == ""
  ] <- "Not recorded"
  
  cleaned
}


normalise_field_name <- function(x) {
  
  x |>
    as.character() |>
    stringr::str_to_upper() |>
    stringr::str_replace_all(
      "[^A-Z0-9]",
      ""
    )
}


# ============================================================
# 8. Find a field using possible aliases
# ============================================================

find_field_name <- function(
    spatial_object,
    possible_names) {
  
  existing_names <- names(
    spatial_object
  )
  
  normalised_existing <- normalise_field_name(
    existing_names
  )
  
  normalised_possible <- normalise_field_name(
    possible_names
  )
  
  matching_position <- which(
    normalised_existing %in%
      normalised_possible
  )
  
  if (length(matching_position) == 0) {
    return(NA_character_)
  }
  
  existing_names[
    matching_position[1]
  ]
}


# ============================================================
# 9. Standardise a field name
# ============================================================

standardise_field_name <- function(
    spatial_object,
    possible_names,
    new_name) {
  
  existing_field <- find_field_name(
    spatial_object,
    possible_names
  )
  
  if (is.na(existing_field)) {
    stop(
      paste(
        "Could not find a required field.",
        "Expected one of:",
        paste(
          possible_names,
          collapse = ", "
        )
      )
    )
  }
  
  if (existing_field != new_name) {
    
    names(spatial_object)[
      names(spatial_object) ==
        existing_field
    ] <- new_name
  }
  
  spatial_object
}


# ============================================================
# 10. Match SO_ASSOCIA values
#
# This allows values such as:
#   Klias
#   Klias Association
#   KLIAS SOIL ASSOCIATION
#   Klias / Sipitang
# ============================================================

matches_soil_association <- function(
    soil_values,
    target_associations) {
  
  cleaned_values <- clean_text(
    soil_values
  )
  
  association_pattern <- paste0(
    "\\b(",
    paste(
      target_associations,
      collapse = "|"
    ),
    ")\\b"
  )
  
  !is.na(cleaned_values) &
    stringr::str_detect(
      cleaned_values,
      association_pattern
    )
}


# ============================================================
# 11. Repair polygon geometry
#
# This function:
#   - removes Z and M dimensions;
#   - removes missing and empty geometry;
#   - repairs invalid geometry;
#   - extracts polygon parts;
#   - optionally applies a zero-distance buffer;
#   - removes zero-area remnants;
#   - does not assume the geometry column is named geometry.
# ============================================================

repair_polygon_geometry <- function(
    spatial_object,
    object_name = "spatial object",
    use_zero_buffer = FALSE,
    remove_zero_area = FALSE) {
  
  if (!inherits(spatial_object, "sf")) {
    stop(
      paste(
        object_name,
        "is not an sf object."
      )
    )
  }
  
  if (is.na(sf::st_crs(spatial_object))) {
    stop(
      paste(
        object_name,
        "does not have a defined CRS."
      )
    )
  }
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  spatial_object <- suppressWarnings(
    sf::st_zm(
      spatial_object,
      drop = TRUE,
      what = "ZM"
    )
  )
  
  missing_geometry <- is.na(
    sf::st_geometry(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !missing_geometry,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  empty_geometry <- tryCatch(
    sf::st_is_empty(
      spatial_object
    ),
    error = function(e) {
      rep(
        FALSE,
        nrow(spatial_object)
      )
    }
  )
  
  spatial_object <- spatial_object[
    !empty_geometry,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !is.na(
      sf::st_geometry(
        spatial_object
      )
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  spatial_object <- spatial_object[
    !sf::st_is_empty(
      spatial_object
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  if (
    any(
      geometry_types ==
      "GEOMETRYCOLLECTION"
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON",
        warn = FALSE
      )
    )
  }
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  polygon_rows <- geometry_types %in%
    c(
      "POLYGON",
      "MULTIPOLYGON"
    )
  
  spatial_object <- spatial_object[
    polygon_rows,
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  if (use_zero_buffer) {
    
    buffered_object <- tryCatch(
      suppressWarnings(
        sf::st_buffer(
          spatial_object,
          dist = 0
        )
      ),
      error = function(e) {
        NULL
      }
    )
    
    if (!is.null(buffered_object)) {
      spatial_object <- buffered_object
    }
  }
  
  spatial_object <- suppressWarnings(
    sf::st_make_valid(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    !is.na(
      sf::st_geometry(
        spatial_object
      )
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  spatial_object <- spatial_object[
    !sf::st_is_empty(
      spatial_object
    ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  if (
    any(
      geometry_types ==
      "GEOMETRYCOLLECTION"
    )
  ) {
    
    spatial_object <- suppressWarnings(
      sf::st_collection_extract(
        spatial_object,
        type = "POLYGON",
        warn = FALSE
      )
    )
  }
  
  geometry_types <- as.character(
    sf::st_geometry_type(
      spatial_object
    )
  )
  
  spatial_object <- spatial_object[
    geometry_types %in%
      c(
        "POLYGON",
        "MULTIPOLYGON"
      ),
    ,
    drop = FALSE
  ]
  
  if (nrow(spatial_object) == 0) {
    return(spatial_object)
  }
  
  if (remove_zero_area) {
    
    polygon_area <- tryCatch(
      as.numeric(
        sf::st_area(
          spatial_object
        )
      ),
      error = function(e) {
        rep(
          NA_real_,
          nrow(spatial_object)
        )
      }
    )
    
    keep_rows <- (
      is.finite(polygon_area) &
        polygon_area > 0
    )
    
    spatial_object <- spatial_object[
      keep_rows,
      ,
      drop = FALSE
    ]
  }
  
  spatial_object
}


# ============================================================
# 12. Prepare a polygon layer for analysis
# ============================================================

prepare_layer_for_analysis <- function(
    spatial_object,
    object_name) {
  
  spatial_object <- repair_polygon_geometry(
    spatial_object = spatial_object,
    object_name = paste(
      object_name,
      "before transformation"
    ),
    use_zero_buffer = FALSE,
    remove_zero_area = FALSE
  )
  
  if (nrow(spatial_object) == 0) {
    stop(
      paste(
        object_name,
        "contains no usable polygons."
      )
    )
  }
  
  spatial_object <- sf::st_transform(
    spatial_object,
    crs = analysis_crs
  )
  
  spatial_object <- repair_polygon_geometry(
    spatial_object = spatial_object,
    object_name = paste(
      object_name,
      "in analysis CRS"
    ),
    use_zero_buffer = TRUE,
    remove_zero_area = TRUE
  )
  
  spatial_object
}


# ============================================================
# 13. Read RSPO polygon layer
#
# The script searches all GeoPackage layers for a polygon layer
# containing both parent and MemeberCat.
# ============================================================

read_rspo_gpkg <- function(gpkg_path) {
  
  layer_names <- sf::st_layers(
    gpkg_path
  )$name
  
  if (length(layer_names) == 0) {
    stop(
      paste(
        "No layers were found in:",
        gpkg_path
      )
    )
  }
  
  for (layer_name in layer_names) {
    
    layer_object <- tryCatch(
      sf::st_read(
        dsn = gpkg_path,
        layer = layer_name,
        quiet = TRUE,
        stringsAsFactors = FALSE
      ),
      error = function(e) {
        NULL
      }
    )
    
    if (
      is.null(layer_object) ||
      !inherits(layer_object, "sf") ||
      nrow(layer_object) == 0
    ) {
      next
    }
    
    parent_field <- find_field_name(
      layer_object,
      c(
        "parent"
      )
    )
    
    member_field <- find_field_name(
      layer_object,
      c(
        "MemeberCat",
        "MemberCat",
        "MemberCategory",
        "Member_Category"
      )
    )
    
    if (
      is.na(parent_field) ||
      is.na(member_field)
    ) {
      next
    }
    
    geometry_types <- unique(
      as.character(
        sf::st_geometry_type(
          layer_object
        )
      )
    )
    
    if (
      any(
        geometry_types %in%
        c(
          "POLYGON",
          "MULTIPOLYGON",
          "GEOMETRYCOLLECTION"
        )
      )
    ) {
      
      message(
        "RSPO layer selected: ",
        layer_name
      )
      
      layer_object <- standardise_field_name(
        spatial_object = layer_object,
        possible_names = c(
          "parent"
        ),
        new_name = "Parent_company"
      )
      
      layer_object <- standardise_field_name(
        spatial_object = layer_object,
        possible_names = c(
          "MemeberCat",
          "MemberCat",
          "MemberCategory",
          "Member_Category"
        ),
        new_name = "Member_category"
      )
      
      return(layer_object)
    }
  }
  
  stop(
    paste(
      "No polygon layer containing parent and",
      "MemeberCat was found in:",
      gpkg_path
    )
  )
}


# ============================================================
# 14. Read a PHU GeoPackage
#
# Searches all layers for a polygon layer containing SO_ASSOCIA.
# ============================================================

read_phu_gpkg <- function(gpkg_file) {
  
  layer_names <- sf::st_layers(
    gpkg_file
  )$name
  
  if (length(layer_names) == 0) {
    stop(
      paste(
        "No layers were found in:",
        basename(gpkg_file)
      )
    )
  }
  
  for (layer_name in layer_names) {
    
    layer_object <- tryCatch(
      sf::st_read(
        dsn = gpkg_file,
        layer = layer_name,
        quiet = TRUE,
        stringsAsFactors = FALSE
      ),
      error = function(e) {
        NULL
      }
    )
    
    if (
      is.null(layer_object) ||
      !inherits(layer_object, "sf") ||
      nrow(layer_object) == 0
    ) {
      next
    }
    
    soil_field <- find_field_name(
      layer_object,
      c(
        "SO_ASSOCIA"
      )
    )
    
    if (is.na(soil_field)) {
      next
    }
    
    geometry_types <- unique(
      as.character(
        sf::st_geometry_type(
          layer_object
        )
      )
    )
    
    if (
      any(
        geometry_types %in%
        c(
          "POLYGON",
          "MULTIPOLYGON",
          "GEOMETRYCOLLECTION"
        )
      )
    ) {
      
      layer_object <- standardise_field_name(
        spatial_object = layer_object,
        possible_names = c(
          "SO_ASSOCIA"
        ),
        new_name = "SO_ASSOCIA"
      )
      
      return(layer_object)
