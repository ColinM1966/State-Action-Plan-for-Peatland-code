  spatial_object = rspo_by_company,
  object_name =
    "RSPO concessions dissolved by company",
  use_zero_buffer = TRUE,
  remove_zero_area = TRUE
)

rspo_by_company <- rspo_by_company |>
  dplyr::left_join(
    company_group_counts,
    by = c(
      "Parent_company",
      "Member_category"
    )
  )

