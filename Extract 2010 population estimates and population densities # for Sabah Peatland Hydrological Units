# ============================================================
# Extract 2010 population estimates and population densities
# for Sabah Peatland Hydrological Units
#
# Summaries produced for each PHU:
#   1. Total PHU
#   2. DoA peat extent:
#      Sapi, Klias, Sipitang and Usukan soil associations
#   3. SFD peat extent:
#      Klias and Sipitang soil associations
#
# Population calculation assumes that each raster cell contains
# an estimated population count for that cell.
#
# NoData values such as -3.402823e+38 are converted to NA.
# ============================================================


# ============================================================
# 1. Required packages
# ============================================================

required_packages <- c(
  "sf",
  "terra",
  "exactextractr",
  "dplyr",
  "purrr",
  "stringr",
  "readr",
  "tibble",
  "tidyr"
)

packages_to_install <- required_packages[
  !required_packages %in%
    rownames(installed.packages())
]

if (length(packages_to_install) > 0) {
  install.packages(
    packages_to_install,
    dependencies = TRUE
  )
}


# ============================================================
# 2. Load packages
# ============================================================

library(sf)
library(terra)
library(exactextractr)
library(dplyr)
library(purrr)
library(stringr)
library(readr)
library(tibble)
library(tidyr)


# ============================================================
# 3. File paths
# ============================================================

population_raster_path <- paste0(
  "C:/Users/User/Documents/Peatland/GIS/",
  "Sabah population2010.tif"
)

phu_folder <- paste0(
  "C:/Users/User/Documents/Peatland/GIS/",
  "PHU-extent"
)

output_folder <- paste0(
  "C:/Users/User/Documents/Peatland/GIS/",
  "PHU-population-results"
)


# ============================================================
# 4. Create output folder
# ============================================================

if (!dir.exists(output_folder)) {
  dir.create(
    output_folder,
    recursive = TRUE
  )
}


# ============================================================
# 5. Check input files and folders
# ============================================================

if (!file.exists(population_raster_path)) {
  stop(
    paste(
      "Population raster not found:",
      population_raster_path
    )
  )
}

if (!dir.exists(phu_folder)) {
  stop(
    paste(
      "PHU folder not found:",
      phu_folder
    )
  )
}

phu_files <- list.files(
  path = phu_folder,
  pattern = "\\.gpkg$",
  full.names = TRUE,
  ignore.case = TRUE
)

if (length(phu_files) == 0) {
  stop(
    paste(
      "No GeoPackage files were found in:",
      phu_folder
    )
  )
}


# ============================================================
# 6. Load population raster
# ============================================================

population_raster <- terra::rast(
  population_raster_path
)

if (terra::nlyr(population_raster) > 1) {
  
  warning(
    paste(
      "The population raster contains",
      terra::nlyr(population_raster),
      "layers. Only the first layer will be used."
    )
  )
  
  population_raster <-
    population_raster[[1]]
}

if (
  is.na(terra::crs(population_raster)) ||
  terra::crs(population_raster) == ""
) {
  stop(
    "The population raster does not have a valid CRS."
  )
}


# ============================================================
# 7. Clean population raster NoData values
#
# The raster contains a NoData sentinel near:
#   -3.402823e+38
#
# The threshold below safely converts these extremely negative
# values to NA.
# ============================================================

population_raster <- terra::ifel(
  population_raster < -1e20,
  NA,
  population_raster
)

# Population values should not be negative.
# Convert any remaining negative values to NA.
population_raster <- terra::ifel(
  population_raster < 0,
  NA,
  population_raster
)

names(population_raster) <- "population"


# ============================================================
# 8. Check cleaned raster values
# ============================================================

population_raster_summary <- terra::global(
  population_raster,
  fun = c(
    "min",
    "max",
    "mean",
    "sum"
  ),
  na.rm = TRUE
)

cat(
  "\nCleaned population raster summary:\n"
)

