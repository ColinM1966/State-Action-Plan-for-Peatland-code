make_buffers <- function(
    fr,
    phu,
    distances,
    outside_only = TRUE,
    include_no_buffer = TRUE
) {
  
  crs <- st_crs(fr)
  
  fr_g <- st_union(
    st_geometry(fr)
  )
  
  phu_g <- st_union(
    st_geometry(phu)
  )
  
  cumulative_list <- list()
  ring_list <- list()
  
  if (include_no_buffer) {
    
    fr_only_g <- safe_intersection(
      fr_g,
      phu_g,
      crs
    )
    
    cumulative_list[["FR_only_no_buffer"]] <- st_sf(
      scenario_type = "no_buffer",
      scenario = "FR_only_no_buffer",
      buffer_m = 0,
      ring = "FR_only",
      geometry = fr_only_g
    )
  }
  
  previous_d <- 0
  
  for (d in distances) {
    
    outer_g <- st_buffer(
      fr_g,
      d
    )
    
    if (outside_only) {
      
      cumulative_g <- safe_difference(
        outer_g,
        fr_g,
        crs
      )
      
    } else {
      
      cumulative_g <- outer_g
    }
    
    cumulative_g <- safe_intersection(
      cumulative_g,
      phu_g,
      crs
    )
    
    cumulative_list[[as.character(d)]] <- st_sf(
      scenario_type = "cumulative_buffer",
      scenario = paste0(
        "0-",
        d,
        "m_buffer"
      ),
      buffer_m = d,
      ring = paste0(
        "0-",
        d,
        "m"
      ),
      geometry = cumulative_g
    )
    
    inner_g <- if (previous_d == 0) {
      
      if (outside_only) {
        
        fr_g
        
      } else {
        
        st_sfc(
          st_geometrycollection(),
          crs = crs
        )
      }
      
    } else {
      
      st_buffer(
        fr_g,
        previous_d
      )
    }
    
    ring_g <- safe_difference(
      outer_g,
      inner_g,
      crs
    )
    
    ring_g <- safe_intersection(
      ring_g,
      phu_g,
      crs
    )
    
    ring_list[[as.character(d)]] <- st_sf(
      scenario_type = "buffer_ring",
      scenario = paste0(
        previous_d,
        "-",
        d,
        "m_ring"
      ),
      buffer_m = d,
      ring = paste0(
        previous_d,
        "-",
        d,
        "m"
      ),
      geometry = ring_g
    )
    
    previous_d <- d
  }
  
  list(
    cumulative = bind_rows(cumulative_list),
    rings = bind_rows(ring_list)
  )
}

