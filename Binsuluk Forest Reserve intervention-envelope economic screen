pv_annuity <- function(r, n) {
  ifelse(
    r == 0,
    n,
    (1 - (1 + r)^(-n)) / r
  )
}

pv_limited_years <- function(r, n_years) {
  map2_dbl(
    r,
    n_years,
    ~ sum(
      1 / (1 + .x)^(1:.y)
    )
  )
}

