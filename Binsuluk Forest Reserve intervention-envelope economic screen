classify_scenario <- function(buffer_one) {
  
  crs <- st_crs(buffer_one)
  
  scenario_type <- buffer_one$scenario_type[1]
  scenario <- buffer_one$scenario[1]
  buffer_m <- buffer_one$buffer_m[1]
  ring <- buffer_one$ring[1]
  
  scen_g <- st_union(
    st_geometry(buffer_one)
  )
  
  peat_g <- layer_polygon_intersection(
    peat_mask,
    scen_g,
    crs
  )
  
  road_excl_g <- line_buffer_intersection(
    roads,
    scen_g,
    cfg$road_exclusion_buffer_m,
    crs
  )
  
  river_excl_g <- line_buffer_intersection(
    rivers,
    scen_g,
    cfg$river_exclusion_buffer_m,
    crs
  )
  
  built_g <- layer_polygon_intersection(
    builtup,
    scen_g,
    crs
  )
  
  exclusion_g <- union_list(
    list(
      road_excl_g,
      river_excl_g,
      built_g
    ),
    crs
  )
  
  peat_no_excl_g <- safe_difference(
    peat_g,
    exclusion_g,
    crs
  )
  
  oilpalm_g <- layer_polygon_intersection(
    oilpalm,
    peat_no_excl_g,
    crs
  )
  
  agriculture_g <- layer_polygon_intersection(
    agriculture,
    peat_no_excl_g,
    crs
  )
  
  bmp_g <- union_list(
    list(
      oilpalm_g,
      agriculture_g
    ),
    crs
  )
  
  hydro_g <- safe_difference(
    peat_no_excl_g,
    bmp_g,
    crs
  )
  
  low_agb_g <- layer_polygon_intersection(
    agb_low,
    hydro_g,
    crs
  )
  
  moderate_agb_g <- layer_polygon_intersection(
    agb_moderate,
    hydro_g,
    crs
  )
  
  high_agb_g <- layer_polygon_intersection(
    agb_high,
    hydro_g,
    crs
  )
  
  agb_classified_g <- union_list(
    list(
      low_agb_g,
      moderate_agb_g,
      high_agb_g
    ),
    crs
  )
  
  agb_unclassified_g <- safe_difference(
    hydro_g,
    agb_classified_g,
    crs
  )
  
  nonpeat_g <- safe_difference(
    scen_g,
    union_list(
      list(
        peat_g,
        exclusion_g
      ),
      crs
    ),
    crs
  )
  
  class_sf <- bind_rows(
    geom_to_class_sf(
      exclusion_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "excluded_infrastructure_built_river_road",
      crs
    ),
    geom_to_class_sf(
      bmp_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "bmp_controlled_drainage_candidate",
      crs
    ),
    geom_to_class_sf(
      low_agb_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "low_AGB_restoration_fire_risk_candidate",
      crs
    ),
    geom_to_class_sf(
      moderate_agb_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "moderate_AGB_ANR_enrichment_candidate",
      crs
    ),
    geom_to_class_sf(
      high_agb_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "high_AGB_canopy_protection_candidate",
      crs
    ),
    geom_to_class_sf(
      agb_unclassified_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "AGB_unclassified_restoration_candidate",
      crs
    ),
    geom_to_class_sf(
      nonpeat_g,
      scenario_type,
      scenario,
      buffer_m,
      ring,
      "non_peat_or_unconfirmed",
      crs
    )
  )
  
  if (nrow(class_sf) > 0) {
    class_sf <- class_sf |>
      add_area_ha(
        area_col = "area_ha"
      )
  }
  
  intervention_g <- union_list(
    list(
      bmp_g,
      low_agb_g,
      moderate_agb_g,
      high_agb_g,
      agb_unclassified_g
    ),
    crs
  )
  
  drain_all_km <- line_length_km(
    drains,
    scen_g
  )
  
  drain_intervention_km <- line_length_km(
    drains,
    intervention_g
  )
  
  hotspot_n <- point_count(
    hotspots,
    peat_no_excl_g
  )
  
  drain_tbl <- tibble(
    scenario_type = scenario_type,
    scenario = scenario,
    buffer_m = buffer_m,
    ring = ring,
    drain_all_km = drain_all_km,
    drain_intervention_km = drain_intervention_km,
    hotspot_count_on_eligible_peat = hotspot_n,
    peat_area_ha = area_ha(peat_g),
    eligible_peat_area_ha = area_ha(peat_no_excl_g),
    fire_prevention_area_ha = area_ha(peat_no_excl_g)
  )
  
  list(
    class_sf = class_sf,
    drain_tbl = drain_tbl
  )
}

