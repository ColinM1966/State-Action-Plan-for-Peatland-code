summarise_titles_one <- function(buffer_one) {
  
  crs <- st_crs(buffer_one)
  
  buffer_g <- st_union(
    st_geometry(buffer_one)
  )
  
  buffer_area_ha <- area_ha(buffer_g)
  
  x <- suppressWarnings(
    st_intersection(
      cadastre,
      buffer_one
    )
  )
  
  if (nrow(x) > 0) {
    
    x <- suppressWarnings(
      st_collection_extract(
        st_make_valid(x),
        "POLYGON",
        warn = FALSE
      )
    )
    
    if (nrow(x) > 0) {
      
      x <- x |>
        add_area_ha(
          area_col = "area_ha"
        )
      
      title_area <- x |>
        st_drop_geometry() |>
        group_by(title_group) |>
        summarise(
          area_ha = sum(
            area_ha,
            na.rm = TRUE
          ),
          .groups = "drop"
        )
      
      cad_g <- st_union(
        st_geometry(x)
      )
      
      residual_g <- safe_difference(
        buffer_g,
        cad_g,
        crs
      )
      
      residual_area_ha <- area_ha(
        residual_g
      )
      
    } else {
      
      title_area <- tibble(
        title_group = character(),
        area_ha = numeric()
      )
      
      residual_area_ha <- buffer_area_ha
    }
    
  } else {
    
    title_area <- tibble(
      title_group = character(),
      area_ha = numeric()
    )
    
    residual_area_ha <- buffer_area_ha
  }
  
  if (residual_area_ha > 0.001) {
    
    title_area <- bind_rows(
      title_area,
      tibble(
        title_group = "Forest_Reserve_or_residual",
        area_ha = residual_area_ha
      )
    ) |>
      group_by(title_group) |>
      summarise(
        area_ha = sum(
          area_ha,
          na.rm = TRUE
        ),
        .groups = "drop"
      )
  }
  
  if (nrow(title_area) == 0) {
    
    title_area <- tibble(
      title_group = "No_cadastral_overlap",
      area_ha = 0
    )
  }
  
  # Do percentage outside mutate() so there is no dplyr size mismatch
  if (buffer_area_ha > 0) {
    title_area$pct_of_buffer <- 100 * title_area$area_ha / buffer_area_ha
  } else {
    title_area$pct_of_buffer <- NA_real_
  }
  
  title_area |>
    mutate(
      scenario_type = buffer_one$scenario_type[1],
      scenario = buffer_one$scenario[1],
      buffer_m = buffer_one$buffer_m[1],
      ring = buffer_one$ring[1],
      buffer_area_ha = buffer_area_ha
    ) |>
    select(
      scenario_type,
      scenario,
      buffer_m,
      ring,
      buffer_area_ha,
      title_group,
      area_ha,
      pct_of_buffer
    )
}

