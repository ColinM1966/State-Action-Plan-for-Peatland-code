read_any_sf <- function(path, layer = NULL) {
  
  if (is.na(path) || !file.exists(path)) {
    return(NULL)
  }
  
  ext <- tolower(tools::file_ext(path))
  
  if (ext == "gpkg" && is.null(layer)) {
    layer <- st_layers(path)$name[1]
  }
  
  if (is.null(layer)) {
    x <- st_read(path, quiet = TRUE)
  } else {
    x <- st_read(path, layer = layer, quiet = TRUE)
  }
  
  x |>
    st_zm(drop = TRUE, what = "ZM") |>
    st_make_valid()
}

to_analysis_crs <- function(x) {
  if (is.null(x)) {
    return(NULL)
  }
  
  st_transform(
    x,
    cfg$analysis_epsg
  )
}

area_ha_vec <- function(x) {
  as.numeric(st_area(x)) / 10000
}

add_area_ha <- function(x, area_col = "area_ha") {
  
  if (is.null(x) || nrow(x) == 0) {
    return(x)
  }
  
  x[[area_col]] <- as.numeric(
    st_area(x)
  ) / 10000
  
  x
}

area_ha <- function(g) {
  if (is.null(g) || length(g) == 0 || all(st_is_empty(g))) {
    return(0)
  }
  
  sum(
    as.numeric(st_area(g)),
    na.rm = TRUE
  ) / 10000
}

geom_is_empty <- function(g) {
  is.null(g) ||
    length(g) == 0 ||
    all(st_is_empty(g))
}

to_poly_sfc <- function(g, crs) {
  
  if (geom_is_empty(g)) {
    return(st_sfc(crs = crs))
  }
  
  g <- suppressWarnings(
    st_make_valid(g)
  )
  
  g <- suppressWarnings(
    st_collection_extract(
      g,
      "POLYGON",
      warn = FALSE
    )
  )
  
  if (geom_is_empty(g)) {
    return(st_sfc(crs = crs))
  }
  
  g
}

safe_intersection <- function(a, b, crs) {
  
  a <- to_poly_sfc(a, crs)
  b <- to_poly_sfc(b, crs)
  
  if (geom_is_empty(a) || geom_is_empty(b)) {
    return(st_sfc(crs = crs))
  }
  
  suppressWarnings(
    st_intersection(a, b)
  ) |>
    to_poly_sfc(crs)
}

safe_difference <- function(a, b, crs) {
  
  a <- to_poly_sfc(a, crs)
  
  if (geom_is_empty(a)) {
    return(a)
  }
  
  b <- to_poly_sfc(b, crs)
  
  if (geom_is_empty(b)) {
    return(a)
  }
  
  suppressWarnings(
    st_difference(a, b)
  ) |>
    to_poly_sfc(crs)
}

union_list <- function(g_list, crs) {
  
  g_list <- g_list[
    map_lgl(
      g_list,
      ~ !geom_is_empty(.x)
    )
  ]
  
  if (length(g_list) == 0) {
    return(
      st_sfc(
        st_geometrycollection(),
        crs = crs
      )
    )
  }
  
  suppressWarnings(
    st_union(
      do.call(c, g_list)
    )
  )
}

clip_layer <- function(x, boundary) {
  
  if (is.null(x)) {
    return(NULL)
  }
  
  x <- st_transform(
    x,
    st_crs(boundary)
  )
  
  suppressWarnings(
    st_filter(
      x,
      boundary,
      .predicate = st_intersects
    )
  )
}

filter_text_any <- function(x, pattern) {
  
  dat <- st_drop_geometry(x)
  
  char_cols <- names(dat)[
    map_lgl(
      dat,
      ~ is.character(.x) || is.factor(.x)
    )
  ]
  
  if (length(char_cols) == 0) {
    return(x[0, ])
  }
  
  hit <- rep(FALSE, nrow(x))
  
  for (cc in char_cols) {
    hit <- hit |
      str_detect(
        as.character(dat[[cc]]),
        regex(pattern, ignore_case = TRUE)
      )
  }
  
  x[hit, ]
}

layer_polygon_intersection <- function(layer, poly_g, crs) {
  
  if (is.null(layer) || geom_is_empty(poly_g)) {
    return(st_sfc(crs = crs))
  }
  
  poly_sf <- st_sf(
    geometry = to_poly_sfc(poly_g, crs)
  )
  
  x <- suppressWarnings(
    st_intersection(
      st_make_valid(layer),
      poly_sf
    )
  )
  
  if (nrow(x) == 0) {
    return(st_sfc(crs = crs))
  }
  
  suppressWarnings(
    st_union(st_geometry(x))
  ) |>
    to_poly_sfc(crs)
}

line_buffer_intersection <- function(layer, poly_g, buffer_m, crs) {
  
  if (is.null(layer) || geom_is_empty(poly_g)) {
    return(st_sfc(crs = crs))
  }
  
  poly_sf <- st_sf(
    geometry = to_poly_sfc(poly_g, crs)
  )
  
  x <- suppressWarnings(
    st_intersection(layer, poly_sf)
  )
  
  if (nrow(x) == 0) {
    return(st_sfc(crs = crs))
  }
  
  suppressWarnings(
    st_buffer(x, buffer_m)
  ) |>
    st_geometry() |>
    st_union() |>
    to_poly_sfc(crs)
}

line_length_km <- function(lines, poly_g) {
  
  if (is.null(lines) || geom_is_empty(poly_g)) {
    return(0)
  }
  
  poly_sf <- st_sf(
    geometry = poly_g
  )
  
  x <- suppressWarnings(
    st_intersection(lines, poly_sf)
  )
  
  if (nrow(x) == 0) {
    return(0)
  }
  
  sum(
    as.numeric(st_length(x)),
    na.rm = TRUE
  ) / 1000
}

point_count <- function(points, poly_g) {
  
  if (is.null(points) || geom_is_empty(poly_g)) {
    return(NA_integer_)
  }
  
  poly_sf <- st_sf(
    geometry = poly_g
  )
  
  length(
    which(
      lengths(
        st_intersects(points, poly_sf)
      ) > 0
    )
  )
}

geom_to_class_sf <- function(
    g,
    scenario_type,
    scenario,
    buffer_m,
    ring,
    intervention_class,
    crs
) {
  
  g <- to_poly_sfc(g, crs)
  
  if (geom_is_empty(g)) {
    return(NULL)
  }
  
  st_sf(
    scenario_type = scenario_type,
    scenario = scenario,
    buffer_m = buffer_m,
    ring = ring,
    intervention_class = intervention_class,
    geometry = g
  )
}

