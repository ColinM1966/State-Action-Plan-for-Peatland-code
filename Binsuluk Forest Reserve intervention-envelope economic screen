summarise_overlap_area <- function(base, overlay, overlay_name) {
  
  if (is.null(overlay) || nrow(overlay) == 0) {
    return(tibble())
  }
  
  overlay_g <- st_union(
    st_geometry(overlay)
  )
  
  x <- suppressWarnings(
    st_intersection(
      base,
      overlay_g
    )
  )
  
  if (nrow(x) == 0) {
    return(tibble())
  }
  
  x <- x |>
    add_area_ha(
      area_col = "area_ha"
    )
  
  x |>
    st_drop_geometry() |>
    group_by(
      scenario_type,
      scenario,
      buffer_m,
      ring
    ) |>
    summarise(
      area_ha = sum(
        area_ha,
        na.rm = TRUE
      ),
      .groups = "drop"
    ) |>
    mutate(
      layer = overlay_name
    )
}

