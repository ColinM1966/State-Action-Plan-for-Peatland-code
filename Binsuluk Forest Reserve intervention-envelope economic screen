econ_summary <- tidyr::crossing(
  area_for_econ,
  assumptions
) |>
  mutate(
    drain_km_for_cost = if_else(
      !is.na(drain_intervention_km) &
        drain_intervention_km > 0,
      drain_intervention_km,
      0
    ),
    
    simple_drain_blocks_n = if_else(
      drain_km_for_cost > 0,
      ceiling(
        drain_km_for_cost * 1000 /
          cfg$drain_block_spacing_m
      ),
      0
    ),
    
    engineered_controls_n = if_else(
      drain_km_for_cost > 0,
      ceiling(
        drain_km_for_cost *
          cfg$engineered_controls_per_km
      ),
      0
    ),
    
    piezometers_n = if_else(
      treated_area_ha > 0,
      pmax(
        cfg$min_piezometers_per_scenario,
        ceiling(
          treated_area_ha /
            cfg$piezometer_ha_per_station
        )
      ),
      0
    ),
    
    pv_factor = pv_annuity(
      discount_rate,
      time_horizon_years
    ),
    
    pv_maintenance_factor = pv_limited_years(
      discount_rate,
      pmin(
        cfg$restoration_maintenance_years,
        time_horizon_years
      )
    ),
    
    restoration_establishment_rm =
      low_AGB_restoration_fire_risk_candidate *
      enrichment_planting_rm_per_ha +
      moderate_AGB_ANR_enrichment_candidate *
      (
        (1 - cfg$enrichment_fraction) *
          anr_rm_per_ha +
          cfg$enrichment_fraction *
          enrichment_planting_rm_per_ha
      ) +
      AGB_unclassified_restoration_candidate *
      (
        (1 - cfg$enrichment_fraction) *
          anr_rm_per_ha +
          cfg$enrichment_fraction *
          enrichment_planting_rm_per_ha
      ),
    
    drain_assessment_rm =
      drain_km_for_cost *
      drain_assessment_rm_per_km,
    
    drain_minor_works_rm =
      drain_km_for_cost *
      drain_minor_works_rm_per_km,
    
    simple_drain_blocks_rm =
      simple_drain_blocks_n *
      simple_drain_block_rm,
    
    engineered_controls_rm =
      engineered_controls_n *
      engineered_water_control_rm,
    
    piezometer_install_rm =
      piezometers_n *
      manual_piezometer_install_rm,
    
    engagement_rm =
      if_else(
        treated_area_ha > 0,
        engagement_rm_per_project,
        0
      ),
    
    capex_rm =
      restoration_establishment_rm +
      drain_assessment_rm +
      drain_minor_works_rm +
      simple_drain_blocks_rm +
      engineered_controls_rm +
      piezometer_install_rm +
      engagement_rm,
    
    annual_piezometer_monitoring_rm =
      piezometers_n *
      manual_piezometer_monitoring_rm_per_year,
    
    annual_fire_prevention_rm =
      fire_prevention_area_ha *
      fire_prevention_rm_per_ha_per_year,
    
    annual_monitoring_reporting_rm =
      if_else(
        treated_area_ha > 0,
        monitoring_reporting_rm_per_year,
        0
      ),
    
    annual_om_rm =
      annual_piezometer_monitoring_rm +
      annual_fire_prevention_rm +
      annual_monitoring_reporting_rm,
    
    restoration_maintenance_pv_rm =
      active_restoration_area_ha *
      maintenance_rm_per_ha_per_year *
      pv_maintenance_factor,
    
    pv_cost_rm =
      capex_rm +
      annual_om_rm *
      pv_factor +
      restoration_maintenance_pv_rm,
    
    annual_avoided_tco2e =
      bmp_controlled_drainage_candidate *
      baseline_drained_oil_palm_tco2e_ha_yr *
      bmp_reduction_factor +
      low_AGB_restoration_fire_risk_candidate *
      baseline_degraded_drained_peat_tco2e_ha_yr *
      low_agb_reduction_factor +
      moderate_AGB_ANR_enrichment_candidate *
      baseline_degraded_drained_peat_tco2e_ha_yr *
      moderate_agb_reduction_factor +
      high_AGB_canopy_protection_candidate *
      baseline_degraded_drained_peat_tco2e_ha_yr *
      high_agb_reduction_factor +
      AGB_unclassified_restoration_candidate *
      baseline_degraded_drained_peat_tco2e_ha_yr *
      unclassified_agb_reduction_factor,
    
    pv_avoided_tco2e =
      annual_avoided_tco2e *
      pv_factor,
    
    annual_carbon_value_rm =
      annual_avoided_tco2e *
      carbon_rm_per_tco2e,
    
    pv_carbon_value_rm =
      pv_avoided_tco2e *
      carbon_rm_per_tco2e,
    
    npv_carbon_only_rm =
      pv_carbon_value_rm -
      pv_cost_rm,
    
    cost_rm_per_tco2e = if_else(
      pv_avoided_tco2e > 0,
      pv_cost_rm / pv_avoided_tco2e,
      NA_real_
    )
  ) |>
  select(
    scenario,
    buffer_m,
    assumption_case,
    
    peat_area_ha,
    eligible_peat_area_ha,
    
    bmp_controlled_drainage_candidate,
    low_AGB_restoration_fire_risk_candidate,
    moderate_AGB_ANR_enrichment_candidate,
    high_AGB_canopy_protection_candidate,
    AGB_unclassified_restoration_candidate,
    active_restoration_area_ha,
    canopy_protection_area_ha,
    excluded_infrastructure_built_river_road,
    non_peat_or_unconfirmed,
    
    drain_all_km,
    drain_intervention_km,
    drain_km_for_cost,
    simple_drain_blocks_n,
