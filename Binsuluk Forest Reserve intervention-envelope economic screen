read_builtup_raster_as_sf <- function(path, boundary_sf) {
  
  if (is.na(path) || !file.exists(path)) {
    return(NULL)
  }
  
  r <- rast(path)
  
  boundary_vect <- vect(
    st_transform(boundary_sf, crs(r))
  )
  
  r_crop <- crop(
    r,
    boundary_vect
  )
  
  r_mask <- mask(
    r_crop,
    boundary_vect
  )
  
  if (cfg$builtup_positive_values_are_built) {
    
    r_built <- ifel(
      !is.na(r_mask) & r_mask > 0,
      1,
      NA
    )
    
  } else {
    
    r_built <- ifel(
      !is.na(r_mask),
      1,
      NA
    )
  }
  
  names(r_built) <- "builtup"
  
  p <- as.polygons(
    r_built,
    dissolve = TRUE,
    na.rm = TRUE
  )
  
  if (is.null(p) || nrow(p) == 0) {
    return(NULL)
  }
  
  st_as_sf(p) |>
    st_make_valid() |>
    st_transform(cfg$analysis_epsg)
}

read_agb_raster_as_classes <- function(path, boundary_sf) {
  
  if (is.na(path) || !file.exists(path)) {
    stop("AGB raster path is missing or does not exist.")
  }
  
  r <- rast(path)
  
  boundary_vect <- vect(
    st_transform(
      boundary_sf,
      crs(r)
    )
  )
  
  r_crop <- crop(
    r,
    boundary_vect
  )
  
  r_mask <- mask(
    r_crop,
    boundary_vect
  )
  
  r_mask <- ifel(
    r_mask < 0,
    NA,
    r_mask
  )
  
  r_class <- classify(
    r_mask,
    rcl = matrix(
      c(
        -1e12, cfg$agb_low_threshold_mg_ha, 1,
        cfg$agb_low_threshold_mg_ha, cfg$agb_high_threshold_mg_ha, 2,
        cfg$agb_high_threshold_mg_ha, 1e12, 3
      ),
      ncol = 3,
      byrow = TRUE
    ),
    include.lowest = TRUE,
    right = FALSE
  )
  
  names(r_class) <- "agb_class_id"
  
  p <- as.polygons(
    r_class,
    dissolve = TRUE,
    na.rm = TRUE
  )
  
  if (is.null(p) || nrow(p) == 0) {
    stop("AGB raster produced no polygons after crop/mask.")
  }
  
  agb_sf <- st_as_sf(p) |>
    st_make_valid() |>
    st_transform(cfg$analysis_epsg) |>
    mutate(
      agb_class_id = as.integer(agb_class_id),
      agb_class = case_when(
        agb_class_id == 1 ~ "low_AGB_restoration_fire_risk_candidate",
        agb_class_id == 2 ~ "moderate_AGB_ANR_enrichment_candidate",
        agb_class_id == 3 ~ "high_AGB_canopy_protection_candidate",
        TRUE ~ "AGB_unclassified_restoration_candidate"
      )
    )
  
  agb_sf
}

